<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ScriptEditor.Controls.SettingsView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Control.Background="{StaticResource BackgroundPrimaryBrush}" xmlns:controls="clr-namespace:ScriptEditor.Controls;assembly=Velocity">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="RowStyle">
        <Style.TargetType>
          <x:Type TypeName="Grid" />
        </Style.TargetType>
        <Setter Property="FrameworkElement.Margin" Value="0,0,0,20" />
      </Style>
      <Style x:Key="PageStyle">
        <Style.TargetType>
          <x:Type TypeName="StackPanel" />
        </Style.TargetType>
        <Setter Property="FrameworkElement.Margin" Value="30,26,26,40" />
        <Setter Property="FrameworkElement.MaxWidth" Value="900" />
        <Setter Property="FrameworkElement.HorizontalAlignment" Value="Stretch" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" FrameworkElement.Margin="30,24,30,18">
      <TextBlock Text="Settings" FontFamily="{StaticResource BodyFont}" FontSize="20" Foreground="{StaticResource TabForegroundActiveBrush}" />
      <TextBlock Text="Changes apply immediately and are saved automatically." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
    </StackPanel>
    <TabControl Grid.Row="1" FrameworkElement.Style="{StaticResource SettingsTabControlStyle}">
      <TabItem HeaderedContentControl.Header="General">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel FrameworkElement.Style="{StaticResource PageStyle}">
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Auto Inject" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Automatically injects when instances are detected." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <ToggleButton Grid.Column="1" FrameworkElement.VerticalAlignment="Center" FrameworkElement.Style="{StaticResource ToggleSwitchStyle}">
                <ToggleButton.IsChecked>
                  <Binding Mode="TwoWay" Path="AutoInject">
                  </Binding>
                </ToggleButton.IsChecked>
              </ToggleButton>
            </Grid>
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <UIElement.IsEnabled>
                <Binding Path="AutoInject">
                </Binding>
              </UIElement.IsEnabled>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Auto Inject delay" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Seconds to let a client finish loading first. Injecting too early crashes it." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" FrameworkElement.VerticalAlignment="Center">
                <Button FrameworkElement.Style="{StaticResource StepperButtonStyle}" FrameworkElement.ToolTip="Shorter">
                  <Path Data="{StaticResource IconMinus}" Shape.Stroke="{StaticResource TabForegroundActiveBrush}" Shape.StrokeThickness="1.2" Shape.StrokeStartLineCap="Round" Shape.StrokeEndLineCap="Round" FrameworkElement.Width="12" FrameworkElement.Height="12" Shape.Stretch="None" />
                  <!--Unknown connection ID: 1-->
                </Button>
                <TextBlock FrameworkElement.Width="30" TextAlignment="Center" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="{StaticResource TabForegroundActiveBrush}" FrameworkElement.VerticalAlignment="Center">
                  <TextBlock.Text>
                    <Binding Path="AutoInjectDelaySeconds">
                    </Binding>
                  </TextBlock.Text>
                </TextBlock>
                <Button FrameworkElement.Style="{StaticResource StepperButtonStyle}" FrameworkElement.ToolTip="Longer">
                  <Path Data="{StaticResource IconPlus}" Shape.Stroke="{StaticResource TabForegroundActiveBrush}" Shape.StrokeThickness="1.2" Shape.StrokeStartLineCap="Round" Shape.StrokeEndLineCap="Round" FrameworkElement.Width="12" FrameworkElement.Height="12" Shape.Stretch="None" />
                  <!--Unknown connection ID: 2-->
                </Button>
              </StackPanel>
            </Grid>
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Save Scripts" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Saves and re-loads your script tabs, including unsaved changes." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <ToggleButton Grid.Column="1" FrameworkElement.VerticalAlignment="Center" FrameworkElement.Style="{StaticResource ToggleSwitchStyle}">
                <ToggleButton.IsChecked>
                  <Binding Mode="TwoWay" Path="SaveScripts">
                  </Binding>
                </ToggleButton.IsChecked>
              </ToggleButton>
            </Grid>
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Auto-pick clients" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Automatically picks all clients to be injected." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <ToggleButton Grid.Column="1" FrameworkElement.VerticalAlignment="Center" FrameworkElement.Style="{StaticResource ToggleSwitchStyle}">
                <ToggleButton.IsChecked>
                  <Binding Mode="TwoWay" Path="AutoPickClients">
                  </Binding>
                </ToggleButton.IsChecked>
              </ToggleButton>
            </Grid>
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Execute on all clients" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Run scripts on every client that has Execute enabled. When off, only the first one. Clients with Execute switched off are always skipped." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <ToggleButton Grid.Column="1" FrameworkElement.VerticalAlignment="Center" FrameworkElement.Style="{StaticResource ToggleSwitchStyle}">
                <ToggleButton.IsChecked>
                  <Binding Mode="TwoWay" Path="ExecuteOnAllClients">
                  </Binding>
                </ToggleButton.IsChecked>
              </ToggleButton>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem HeaderedContentControl.Header="Editor">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel FrameworkElement.Style="{StaticResource PageStyle}">
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Font" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Monospace families installed on this machine." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <ComboBox Grid.Column="1" FrameworkElement.VerticalAlignment="Center" FrameworkElement.Style="{StaticResource SettingsComboBoxStyle}">
                <ItemsControl.ItemsSource>
                  <Binding Path="AvailableFonts">
                  </Binding>
                </ItemsControl.ItemsSource>
                <Selector.SelectedItem>
                  <Binding Mode="TwoWay" Path="FontFamily">
                  </Binding>
                </Selector.SelectedItem>
              </ComboBox>
            </Grid>
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Font size" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Between 8 and 32 pixels." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" FrameworkElement.VerticalAlignment="Center">
                <Button FrameworkElement.Style="{StaticResource StepperButtonStyle}" FrameworkElement.ToolTip="Smaller">
                  <Path Data="{StaticResource IconMinus}" Shape.Stroke="{StaticResource TabForegroundActiveBrush}" Shape.StrokeThickness="1.2" Shape.StrokeStartLineCap="Round" Shape.StrokeEndLineCap="Round" FrameworkElement.Width="12" FrameworkElement.Height="12" Shape.Stretch="None" />
                  <!--Unknown connection ID: 3-->
                </Button>
                <TextBlock FrameworkElement.Width="30" TextAlignment="Center" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="{StaticResource TabForegroundActiveBrush}" FrameworkElement.VerticalAlignment="Center">
                  <TextBlock.Text>
                    <Binding Path="FontSize">
                    </Binding>
                  </TextBlock.Text>
                </TextBlock>
                <Button FrameworkElement.Style="{StaticResource StepperButtonStyle}" FrameworkElement.ToolTip="Larger">
                  <Path Data="{StaticResource IconPlus}" Shape.Stroke="{StaticResource TabForegroundActiveBrush}" Shape.StrokeThickness="1.2" Shape.StrokeStartLineCap="Round" Shape.StrokeEndLineCap="Round" FrameworkElement.Width="12" FrameworkElement.Height="12" Shape.Stretch="None" />
                  <!--Unknown connection ID: 4-->
                </Button>
              </StackPanel>
            </Grid>
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Ligatures" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Join sequences like ~= and .. where the font supports it." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <ToggleButton Grid.Column="1" FrameworkElement.VerticalAlignment="Center" FrameworkElement.Style="{StaticResource ToggleSwitchStyle}">
                <ToggleButton.IsChecked>
                  <Binding Mode="TwoWay" Path="FontLigatures">
                  </Binding>
                </ToggleButton.IsChecked>
              </ToggleButton>
            </Grid>
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Tab width" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Spaces inserted per indent level." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" FrameworkElement.VerticalAlignment="Center">
                <RadioButton FrameworkElement.Style="{StaticResource SegmentButtonStyle}" ContentControl.Content="2">
                  <ToggleButton.IsChecked>
                    <Binding Mode="TwoWay" Converter="{StaticResource IntEquals}" ConverterParameter="2" Path="TabSize">
                    </Binding>
                  </ToggleButton.IsChecked>
                </RadioButton>
                <RadioButton FrameworkElement.Style="{StaticResource SegmentButtonStyle}" ContentControl.Content="4">
                  <ToggleButton.IsChecked>
                    <Binding Mode="TwoWay" Converter="{StaticResource IntEquals}" ConverterParameter="4" Path="TabSize">
                    </Binding>
                  </ToggleButton.IsChecked>
                </RadioButton>
                <RadioButton FrameworkElement.Style="{StaticResource SegmentButtonStyle}" ContentControl.Content="8">
                  <ToggleButton.IsChecked>
                    <Binding Mode="TwoWay" Converter="{StaticResource IntEquals}" ConverterParameter="8" Path="TabSize">
                    </Binding>
                  </ToggleButton.IsChecked>
                </RadioButton>
              </StackPanel>
            </Grid>
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Word wrap" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Wrap long lines instead of scrolling sideways." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <ToggleButton Grid.Column="1" FrameworkElement.VerticalAlignment="Center" FrameworkElement.Style="{StaticResource ToggleSwitchStyle}">
                <ToggleButton.IsChecked>
                  <Binding Mode="TwoWay" Path="WordWrap">
                  </Binding>
                </ToggleButton.IsChecked>
              </ToggleButton>
            </Grid>
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Auto-close brackets" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Insert the closing bracket or quote as you type." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <ToggleButton Grid.Column="1" FrameworkElement.VerticalAlignment="Center" FrameworkElement.Style="{StaticResource ToggleSwitchStyle}">
                <ToggleButton.IsChecked>
                  <Binding Mode="TwoWay" Path="AutoClosingBrackets">
                  </Binding>
                </ToggleButton.IsChecked>
              </ToggleButton>
            </Grid>
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Colour bracket pairs" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Tint matching brackets by nesting depth." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <ToggleButton Grid.Column="1" FrameworkElement.VerticalAlignment="Center" FrameworkElement.Style="{StaticResource ToggleSwitchStyle}">
                <ToggleButton.IsChecked>
                  <Binding Mode="TwoWay" Path="BracketColorization">
                  </Binding>
                </ToggleButton.IsChecked>
              </ToggleButton>
            </Grid>
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Show whitespace" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Render spaces and tabs as dots and arrows." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <ToggleButton Grid.Column="1" FrameworkElement.VerticalAlignment="Center" FrameworkElement.Style="{StaticResource ToggleSwitchStyle}">
                <ToggleButton.IsChecked>
                  <Binding Mode="TwoWay" Path="ShowWhitespace">
                  </Binding>
                </ToggleButton.IsChecked>
              </ToggleButton>
            </Grid>
            <Border FrameworkElement.Height="1" Background="{StaticResource BorderStrokeBrush}" FrameworkElement.Margin="0,4,0,18" />
            <Button FrameworkElement.Style="{StaticResource SettingsTextButtonStyle}" ContentControl.Content="Reset editor settings to defaults" FrameworkElement.HorizontalAlignment="Left">
              <!--Unknown connection ID: 5-->
            </Button>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem HeaderedContentControl.Header="Appearance">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel FrameworkElement.Style="{StaticResource PageStyle}">
            <StackPanel FrameworkElement.Margin="0,0,0,22">
              <TextBlock Text="Accent colour" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
              <TextBlock Text="Used for the active tab marker, unsaved dots and switches." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              <StackPanel Orientation="Horizontal" FrameworkElement.Margin="0,12,0,0">
                <RadioButton FrameworkElement.Style="{StaticResource AccentSwatchStyle}" Control.Background="#C4785C" FrameworkElement.ToolTip="Ember">
                  <ToggleButton.IsChecked>
                    <Binding Mode="TwoWay" Converter="{StaticResource StringEquals}" ConverterParameter="#C4785C" Path="AccentColor">
                    </Binding>
                  </ToggleButton.IsChecked>
                </RadioButton>
                <RadioButton FrameworkElement.Style="{StaticResource AccentSwatchStyle}" Control.Background="#C9A26D" FrameworkElement.ToolTip="Amber">
                  <ToggleButton.IsChecked>
                    <Binding Mode="TwoWay" Converter="{StaticResource StringEquals}" ConverterParameter="#C9A26D" Path="AccentColor">
                    </Binding>
                  </ToggleButton.IsChecked>
                </RadioButton>
                <RadioButton FrameworkElement.Style="{StaticResource AccentSwatchStyle}" Control.Background="#8AA872" FrameworkElement.ToolTip="Sage">
                  <ToggleButton.IsChecked>
                    <Binding Mode="TwoWay" Converter="{StaticResource StringEquals}" ConverterParameter="#8AA872" Path="AccentColor">
                    </Binding>
                  </ToggleButton.IsChecked>
                </RadioButton>
                <RadioButton FrameworkElement.Style="{StaticResource AccentSwatchStyle}" Control.Background="#6E9CB8" FrameworkElement.ToolTip="Steel">
                  <ToggleButton.IsChecked>
                    <Binding Mode="TwoWay" Converter="{StaticResource StringEquals}" ConverterParameter="#6E9CB8" Path="AccentColor">
                    </Binding>
                  </ToggleButton.IsChecked>
                </RadioButton>
                <RadioButton FrameworkElement.Style="{StaticResource AccentSwatchStyle}" Control.Background="#B0A0D0" FrameworkElement.ToolTip="Orchid">
                  <ToggleButton.IsChecked>
                    <Binding Mode="TwoWay" Converter="{StaticResource StringEquals}" ConverterParameter="#B0A0D0" Path="AccentColor">
                    </Binding>
                  </ToggleButton.IsChecked>
                </RadioButton>
              </StackPanel>
            </StackPanel>
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Minimap" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Overview of the file down the right edge." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <ToggleButton Grid.Column="1" FrameworkElement.VerticalAlignment="Center" FrameworkElement.Style="{StaticResource ToggleSwitchStyle}">
                <ToggleButton.IsChecked>
                  <Binding Mode="TwoWay" Path="ShowMinimap">
                  </Binding>
                </ToggleButton.IsChecked>
              </ToggleButton>
            </Grid>
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Line numbers" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
              </StackPanel>
              <ToggleButton Grid.Column="1" FrameworkElement.VerticalAlignment="Center" FrameworkElement.Style="{StaticResource ToggleSwitchStyle}">
                <ToggleButton.IsChecked>
                  <Binding Mode="TwoWay" Path="ShowLineNumbers">
                  </Binding>
                </ToggleButton.IsChecked>
              </ToggleButton>
            </Grid>
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Smooth scrolling" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Animate the editor when scrolling or jumping." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <ToggleButton Grid.Column="1" FrameworkElement.VerticalAlignment="Center" FrameworkElement.Style="{StaticResource ToggleSwitchStyle}">
                <ToggleButton.IsChecked>
                  <Binding Mode="TwoWay" Path="SmoothScrolling">
                  </Binding>
                </ToggleButton.IsChecked>
              </ToggleButton>
            </Grid>
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Splash screen" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Show the logo while the editor loads. Takes effect next launch." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <ToggleButton Grid.Column="1" FrameworkElement.VerticalAlignment="Center" FrameworkElement.Style="{StaticResource ToggleSwitchStyle}">
                <ToggleButton.IsChecked>
                  <Binding Mode="TwoWay" Path="ShowSplash">
                  </Binding>
                </ToggleButton.IsChecked>
              </ToggleButton>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem HeaderedContentControl.Header="Files">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel FrameworkElement.Style="{StaticResource PageStyle}">
            <StackPanel FrameworkElement.Margin="0,0,0,24">
              <TextBlock Text="Scripts folder" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
              <TextBlock Text="The folder the explorer reads. Avoid putting scripts inside the app's build output — a rebuild can wipe it." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              <Border FrameworkElement.Margin="0,10,0,0" Background="#1C1C24" BorderBrush="{StaticResource BorderStrokeBrush}" BorderThickness="1" CornerRadius="3" Padding="9,6">
                <TextBlock FontFamily="{StaticResource BodyFont}" FontSize="11" Foreground="{StaticResource TabForegroundBrush}" TextTrimming="CharacterEllipsis">
                  <TextBlock.Text>
                    <Binding Path="ScriptsFolder">
                    </Binding>
                  </TextBlock.Text>
                </TextBlock>
              </Border>
              <StackPanel Orientation="Horizontal" FrameworkElement.Margin="0,8,0,0">
                <Button FrameworkElement.Style="{StaticResource SettingsTextButtonStyle}" ContentControl.Content="Change folder…">
                  <!--Unknown connection ID: 6-->
                </Button>
                <TextBlock Text="·" FrameworkElement.Margin="8,0" Foreground="{StaticResource TabForegroundBrush}" FrameworkElement.VerticalAlignment="Center" />
                <Button FrameworkElement.Style="{StaticResource SettingsTextButtonStyle}" ContentControl.Content="Use default">
                  <!--Unknown connection ID: 7-->
                </Button>
                <TextBlock Text="·" FrameworkElement.Margin="8,0" Foreground="{StaticResource TabForegroundBrush}" FrameworkElement.VerticalAlignment="Center" />
                <Button FrameworkElement.Style="{StaticResource SettingsTextButtonStyle}" ContentControl.Content="Open in File Explorer">
                  <!--Unknown connection ID: 8-->
                </Button>
              </StackPanel>
            </StackPanel>
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Auto save" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Save files that already have a path shortly after you stop typing. Untitled tabs still need Ctrl+S." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <ToggleButton Grid.Column="1" FrameworkElement.VerticalAlignment="Center" FrameworkElement.Style="{StaticResource ToggleSwitchStyle}">
                <ToggleButton.IsChecked>
                  <Binding Mode="TwoWay" Path="AutoSave">
                  </Binding>
                </ToggleButton.IsChecked>
              </ToggleButton>
            </Grid>
            <Grid FrameworkElement.Style="{StaticResource RowStyle}">
              <UIElement.IsEnabled>
                <Binding Path="AutoSave">
                </Binding>
              </UIElement.IsEnabled>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" FrameworkElement.Margin="0,0,20,0">
                <TextBlock Text="Auto save delay" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
                <TextBlock Text="Seconds of inactivity before saving." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" FrameworkElement.VerticalAlignment="Center">
                <Button FrameworkElement.Style="{StaticResource StepperButtonStyle}" FrameworkElement.ToolTip="Shorter">
                  <Path Data="{StaticResource IconMinus}" Shape.Stroke="{StaticResource TabForegroundActiveBrush}" Shape.StrokeThickness="1.2" Shape.StrokeStartLineCap="Round" Shape.StrokeEndLineCap="Round" FrameworkElement.Width="12" FrameworkElement.Height="12" Shape.Stretch="None" />
                  <!--Unknown connection ID: 9-->
                </Button>
                <TextBlock FrameworkElement.Width="30" TextAlignment="Center" FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="{StaticResource TabForegroundActiveBrush}" FrameworkElement.VerticalAlignment="Center">
                  <TextBlock.Text>
                    <Binding Path="AutoSaveDelaySeconds">
                    </Binding>
                  </TextBlock.Text>
                </TextBlock>
                <Button FrameworkElement.Style="{StaticResource StepperButtonStyle}" FrameworkElement.ToolTip="Longer">
                  <Path Data="{StaticResource IconPlus}" Shape.Stroke="{StaticResource TabForegroundActiveBrush}" Shape.StrokeThickness="1.2" Shape.StrokeStartLineCap="Round" Shape.StrokeEndLineCap="Round" FrameworkElement.Width="12" FrameworkElement.Height="12" Shape.Stretch="None" />
                  <!--Unknown connection ID: 10-->
                </Button>
              </StackPanel>
            </Grid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <TabItem HeaderedContentControl.Header="Script Hub">
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <StackPanel FrameworkElement.Style="{StaticResource PageStyle}">
            <TextBlock Text="rscripts.net API key" FrameworkElement.Style="{StaticResource SettingsLabelStyle}" />
            <TextBlock FrameworkElement.Style="{StaticResource SettingsHintStyle}" TextWrapping="Wrap">
              <Run Text="The hub uses the rscripts.net public API, which needs a key. Create one from your dashboard, then paste it here. It is stored encrypted for your Windows account, not in plain text." />
            </TextBlock>
            <Border FrameworkElement.Margin="0,10,0,0" Background="#1C1C24" BorderBrush="{StaticResource BorderStrokeBrush}" BorderThickness="1" CornerRadius="3">
              <PasswordBox Name="ApiKeyBox" Control.Padding="9,6" Control.Background="#00FFFFFF" Control.BorderThickness="0" Control.Foreground="{StaticResource TabForegroundActiveBrush}" CaretBrush="{StaticResource TabForegroundActiveBrush}" Control.FontFamily="{StaticResource BodyFont}" Control.FontSize="11">
                <!--Unknown connection ID: 11-->
              </PasswordBox>
            </Border>
            <StackPanel Orientation="Horizontal" FrameworkElement.Margin="0,8,0,0">
              <Button FrameworkElement.Style="{StaticResource SettingsTextButtonStyle}" ContentControl.Content="Get an API key">
                <!--Unknown connection ID: 12-->
              </Button>
              <TextBlock Text="·" FrameworkElement.Margin="8,0" Foreground="{StaticResource TabForegroundBrush}" FrameworkElement.VerticalAlignment="Center" />
              <Button FrameworkElement.Style="{StaticResource SettingsTextButtonStyle}" ContentControl.Content="Clear key">
                <!--Unknown connection ID: 13-->
              </Button>
            </StackPanel>
            <TextBlock FrameworkElement.Margin="0,10,0,0" FrameworkElement.Style="{StaticResource SettingsHintStyle}" Foreground="{StaticResource OutputSuccessBrush}" Text="Key saved.">
              <UIElement.Visibility>
                <Binding Converter="{StaticResource BoolToVisibility}" Path="HasScriptHubApiKey">
                </Binding>
              </UIElement.Visibility>
            </TextBlock>
            <Border FrameworkElement.Height="1" Background="{StaticResource BorderStrokeBrush}" FrameworkElement.Margin="0,20,0,18" />
            <TextBlock Text="SAFETY" FrameworkElement.Style="{StaticResource SettingsSectionStyle}" />
