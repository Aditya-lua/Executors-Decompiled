<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="ScriptEditor.Controls.ClientPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Window.Title="Choose clients" FrameworkElement.Width="380" Window.SizeToContent="Height" FrameworkElement.MaxHeight="460" Window.WindowStyle="None" Window.WindowStartupLocation="CenterOwner" Window.ResizeMode="NoResize" Window.ShowInTaskbar="False" Window.AllowsTransparency="True" Control.Background="#00FFFFFF" FrameworkElement.UseLayoutRounding="True" xmlns:media="clr-namespace:System.Windows.Media;assembly=PresentationFramework" media:TextOptions.TextFormattingMode="Ideal" media:TextOptions.TextRenderingMode="ClearType" xmlns:controls="clr-namespace:ScriptEditor.Controls;assembly=Velocity">
  <Border Background="{StaticResource BackgroundPrimaryBrush}" BorderBrush="{StaticResource BorderStrokeBrush}" BorderThickness="1" CornerRadius="6">
    <Grid FrameworkElement.Margin="20,18,20,16">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto" />
        <RowDefinition Height="*" />
        <RowDefinition Height="Auto" />
      </Grid.RowDefinitions>
      <StackPanel Grid.Row="0" FrameworkElement.Margin="0,0,0,14">
        <TextBlock Text="Choose clients" FontFamily="{StaticResource BodyFont}" FontSize="15" Foreground="{StaticResource TabForegroundActiveBrush}" />
        <TextBlock Text="Pick which Roblox clients to inject into." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
      </StackPanel>
      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" FrameworkElement.MaxHeight="280">
        <ItemsControl Name="ClientList">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Background="#00FFFFFF" Padding="0,5">
                <StackPanel Orientation="Horizontal">
                  <ToggleButton FrameworkElement.Style="{StaticResource ToggleSwitchStyle}" FrameworkElement.VerticalAlignment="Center">
                    <ToggleButton.IsChecked>
                      <Binding Mode="TwoWay" Path="IsSelected">
                      </Binding>
                    </ToggleButton.IsChecked>
                  </ToggleButton>
                  <StackPanel FrameworkElement.Margin="12,0,0,0" FrameworkElement.VerticalAlignment="Center">
                    <TextBlock FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="{StaticResource TabForegroundActiveBrush}">
                      <TextBlock.Text>
                        <Binding Path="Title">
                        </Binding>
                      </TextBlock.Text>
                    </TextBlock>
                    <TextBlock FrameworkElement.Style="{StaticResource SettingsHintStyle}" FrameworkElement.Margin="0,1,0,0">
                      <TextBlock.Text>
                        <Binding Path="Detail">
                        </Binding>
                      </TextBlock.Text>
                    </TextBlock>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
          <!--Unknown connection ID: 1-->
        </ItemsControl>
      </ScrollViewer>
      <StackPanel Grid.Row="2" Orientation="Horizontal" FrameworkElement.HorizontalAlignment="Right" FrameworkElement.Margin="0,16,0,0">
        <Button FrameworkElement.Style="{StaticResource SettingsTextButtonStyle}" ContentControl.Content="Cancel" FrameworkElement.Margin="0,0,18,0">
          <!--Unknown connection ID: 2-->
        </Button>
        <Button FrameworkElement.Style="{StaticResource SettingsTextButtonStyle}" ContentControl.Content="Inject" Control.Foreground="{DynamicResource AccentBrush}">
          <!--Unknown connection ID: 3-->
        </Button>
      </StackPanel>
    </Grid>
  </Border>
</Window>