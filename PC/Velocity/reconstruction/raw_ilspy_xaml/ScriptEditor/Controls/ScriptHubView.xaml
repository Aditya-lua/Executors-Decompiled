<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="ScriptEditor.Controls.ScriptHubView" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Control.Background="{StaticResource BackgroundPrimaryBrush}" xmlns:controls="clr-namespace:ScriptEditor.Controls;assembly=Velocity">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <StackPanel Grid.Row="0" FrameworkElement.Margin="30,24,30,0">
      <TextBlock Text="Script Hub" FontFamily="{StaticResource BodyFont}" FontSize="20" Foreground="{StaticResource TabForegroundActiveBrush}" />
      <TextBlock Text="Browse rscripts.net. Read anything before you run it." FrameworkElement.Style="{StaticResource SettingsHintStyle}" />
    </StackPanel>
    <StackPanel Grid.Row="1" FrameworkElement.Margin="30,16,30,14">
      <UIElement.Visibility>
        <Binding Converter="{StaticResource BoolToVisibility}">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Hub.HasApiKey</Ctor>
        </Binding>
      </UIElement.Visibility>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#1C1C24" BorderBrush="{StaticResource BorderStrokeBrush}" BorderThickness="1" CornerRadius="3" FrameworkElement.Height="28">
          <TextBox Name="SearchBox" Control.VerticalContentAlignment="Center" Control.Padding="9,0" Control.Background="#00FFFFFF" Control.BorderThickness="0" Control.Foreground="{StaticResource TabForegroundActiveBrush}" TextBoxBase.CaretBrush="{StaticResource TabForegroundActiveBrush}" TextBoxBase.SelectionBrush="{DynamicResource AccentBrush}" Control.FontFamily="{StaticResource BodyFont}" Control.FontSize="12">
            <TextBox.Text>
              <Binding Mode="TwoWay" UpdateSourceTrigger="PropertyChanged">
                <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Hub.Query</Ctor>
              </Binding>
            </TextBox.Text>
            <!--Unknown connection ID: 1-->
          </TextBox>
        </Border>
        <ComboBox Grid.Column="1" FrameworkElement.Width="120" FrameworkElement.Height="28" FrameworkElement.Margin="8,0,0,0" FrameworkElement.Style="{StaticResource SettingsComboBoxStyle}">
          <ItemsControl.ItemsSource>
            <Binding>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Hub.SortOptions</Ctor>
            </Binding>
          </ItemsControl.ItemsSource>
          <Selector.SelectedItem>
            <Binding Mode="TwoWay">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Hub.Sort</Ctor>
            </Binding>
          </Selector.SelectedItem>
          <!--Unknown connection ID: 2-->
        </ComboBox>
        <Button Grid.Column="2" FrameworkElement.Margin="8,0,0,0" FrameworkElement.Style="{StaticResource ActionBarButtonStyle}" ContentControl.Content="Search" FrameworkElement.Tag="{StaticResource IconExecuteImage}">
          <!--Unknown connection ID: 3-->
        </Button>
      </Grid>
      <StackPanel Orientation="Horizontal" FrameworkElement.Margin="0,10,0,0">
        <ToggleButton FrameworkElement.Style="{StaticResource FilterChipStyle}" ContentControl.Content="No key system">
          <ToggleButton.IsChecked>
            <Binding Mode="TwoWay">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.HubNoKeySystem</Ctor>
            </Binding>
          </ToggleButton.IsChecked>
          <!--Unknown connection ID: 4-->
        </ToggleButton>
        <ToggleButton FrameworkElement.Style="{StaticResource FilterChipStyle}" ContentControl.Content="Free only">
          <ToggleButton.IsChecked>
            <Binding Mode="TwoWay">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.HubFreeOnly</Ctor>
            </Binding>
          </ToggleButton.IsChecked>
          <!--Unknown connection ID: 5-->
        </ToggleButton>
        <ToggleButton FrameworkElement.Style="{StaticResource FilterChipStyle}" ContentControl.Content="Verified">
          <ToggleButton.IsChecked>
            <Binding Mode="TwoWay">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.HubVerifiedOnly</Ctor>
            </Binding>
          </ToggleButton.IsChecked>
          <!--Unknown connection ID: 6-->
        </ToggleButton>
        <ToggleButton FrameworkElement.Style="{StaticResource FilterChipStyle}" ContentControl.Content="Mobile ready">
          <ToggleButton.IsChecked>
            <Binding Mode="TwoWay">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Settings.HubMobileOnly</Ctor>
            </Binding>
          </ToggleButton.IsChecked>
          <!--Unknown connection ID: 7-->
        </ToggleButton>
      </StackPanel>
    </StackPanel>
    <Grid Row="2">
      <StackPanel FrameworkElement.Margin="30,10,30,0" FrameworkElement.VerticalAlignment="Top">
        <UIElement.Visibility>
          <Binding Converter="{StaticResource BoolToVisibility}">
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Hub.ShowKeyPrompt</Ctor>
          </Binding>
        </UIElement.Visibility>
        <TextBlock Text="Connect rscripts.net" FontFamily="{StaticResource BodyFont}" FontSize="14" Foreground="{StaticResource TabForegroundActiveBrush}" />
        <TextBlock FrameworkElement.Style="{StaticResource SettingsHintStyle}" TextWrapping="Wrap" Text="The hub needs an API key from your rscripts.net dashboard. Add it in Settings → Script Hub and it will load from there." />
        <Button FrameworkElement.Style="{StaticResource SettingsTextButtonStyle}" ContentControl.Content="Open Settings → Script Hub" FrameworkElement.HorizontalAlignment="Left" FrameworkElement.Margin="0,10,0,0">
          <!--Unknown connection ID: 8-->
        </Button>
      </StackPanel>
      <TextBlock FrameworkElement.Margin="30,10,30,0" FrameworkElement.VerticalAlignment="Top" FrameworkElement.Style="{StaticResource SettingsHintStyle}" Text="Loading…">
        <UIElement.Visibility>
          <Binding Converter="{StaticResource BoolToVisibility}">
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Hub.IsLoading</Ctor>
          </Binding>
        </UIElement.Visibility>
      </TextBlock>
      <StackPanel FrameworkElement.Margin="30,10,30,0" FrameworkElement.VerticalAlignment="Top">
        <UIElement.Visibility>
          <Binding Converter="{StaticResource BoolToVisibility}">
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Hub.HasError</Ctor>
          </Binding>
        </UIElement.Visibility>
        <TextBlock FontFamily="{StaticResource BodyFont}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource OutputErrorBrush}">
          <TextBlock.Text>
            <Binding>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Hub.Error</Ctor>
            </Binding>
          </TextBlock.Text>
        </TextBlock>
        <Button FrameworkElement.Style="{StaticResource SettingsTextButtonStyle}" ContentControl.Content="Try again" FrameworkElement.HorizontalAlignment="Left" FrameworkElement.Margin="0,8,0,0">
          <!--Unknown connection ID: 9-->
        </Button>
      </StackPanel>
      <TextBlock FrameworkElement.Margin="30,10,30,0" FrameworkElement.VerticalAlignment="Top" FrameworkElement.Style="{StaticResource SettingsHintStyle}" Text="No scripts matched. Try a different search or loosen the filters.">
        <UIElement.Visibility>
          <Binding Converter="{StaticResource BoolToVisibility}">
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Hub.ShowEmpty</Ctor>
          </Binding>
        </UIElement.Visibility>
      </TextBlock>
      <ScrollViewer Name="ResultsScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Control.Padding="24,0,20,10">
        <UIElement.Visibility>
          <Binding Converter="{StaticResource BoolToVisibility}">
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Hub.ShowResults</Ctor>
          </Binding>
        </UIElement.Visibility>
        <ItemsControl>
          <ItemsControl.ItemsSource>
            <Binding>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Hub.Results</Ctor>
            </Binding>
          </ItemsControl.ItemsSource>
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid>
                <UniformGrid.Columns>
                  <Binding>
                    <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ResultColumns</Ctor>
                    <Binding.RelativeSource>
                      <RelativeSource AncestorType="UserControl" />
                    </Binding.RelativeSource>
                  </Binding>
                </UniformGrid.Columns>
              </UniformGrid>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border FrameworkElement.Margin="6" Background="#14FFFFFF" CornerRadius="5" BorderBrush="{StaticResource BorderStrokeBrush}" BorderThickness="1">
                <StackPanel>
                  <Border FrameworkElement.Height="96" CornerRadius="4,4,0,0" UIElement.ClipToBounds="True" Background="#1C1C24">
                    <Grid>
                      <Rectangle FrameworkElement.Width="26" FrameworkElement.Height="26" Shape.Fill="{StaticResource TextMutedBrush}" FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" RenderOptions.BitmapScalingMode="HighQuality">
                        <UIElement.OpacityMask>
                          <ImageBrush ImageSource="{StaticResource IconRobloxImage}" TileBrush.Stretch="Uniform" />
                        </UIElement.OpacityMask>
                      </Rectangle>
                      <Image Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality">
                        <Image.Source>
                          <Binding IsAsync="True" Converter="{StaticResource Thumbnail}">
                            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">ThumbnailUrl</Ctor>
                          </Binding>
                        </Image.Source>
                      </Image>
                    </Grid>
                  </Border>
                  <StackPanel FrameworkElement.Margin="11,9,11,11">
                    <TextBlock FontFamily="{StaticResource BodyFont}" FontSize="12" Foreground="{StaticResource TabForegroundActiveBrush}" TextTrimming="CharacterEllipsis" FrameworkElement.MaxHeight="34" TextWrapping="Wrap">
                      <TextBlock.Text>
                        <Binding>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Title</Ctor>
                        </Binding>
                      </TextBlock.Text>
                    </TextBlock>
                    <TextBlock FrameworkElement.Margin="0,5,0,0" FontFamily="{StaticResource BodyFont}" FontSize="10.5" Foreground="{StaticResource TabForegroundBrush}" TextTrimming="CharacterEllipsis">
                      <Run>
                        <Run.Text>
                          <Binding Mode="OneWay">
                            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">GameText</Ctor>
                          </Binding>
                        </Run.Text>
                      </Run> <Run Text="·" /> <Run><Run.Text><Binding Mode="OneWay"><Ctor xmlns="https://github.com/icsharpcode/ILSpy">CreatorText</Ctor></Binding></Run.Text></Run></TextBlock>
                    <TextBlock FrameworkElement.Margin="0,3,0,0" FontFamily="{StaticResource BodyFont}" FontSize="10.5" Foreground="{StaticResource TextMutedBrush}">
                      <TextBlock.Text>
                        <Binding>
                          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">StatsText</Ctor>
                        </Binding>
                      </TextBlock.Text>
                    </TextBlock>
                    <WrapPanel FrameworkElement.Margin="0,8,0,0">
                      <Border FrameworkElement.Style="{StaticResource BadgeStyle}" FrameworkElement.ToolTip="Risk score from rscripts.net">
                        <TextBlock FrameworkElement.Style="{StaticResource BadgeTextStyle}">
                          <TextBlock.Text>
                            <Binding>
                              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">RiskText</Ctor>
                            </Binding>
                          </TextBlock.Text>
                        </TextBlock>
                      </Border>
                      <Border FrameworkElement.Style="{StaticResource BadgeStyle}" FrameworkElement.ToolTip="Requires a key from the author">
                        <UIElement.Visibility>
                          <Binding Converter="{StaticResource BoolToVisibility}">
                            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsKeySystem</Ctor>
                          </Binding>
                        </UIElement.Visibility>
                        <TextBlock Text="Key system" FrameworkElement.Style="{StaticResource BadgeTextStyle}" />
                      </Border>
                      <Border FrameworkElement.Style="{StaticResource BadgeStyle}">
                        <UIElement.Visibility>
                          <Binding Converter="{StaticResource BoolToVisibility}">
                            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsPaid</Ctor>
                          </Binding>
                        </UIElement.Visibility>
                        <TextBlock Text="Paid" FrameworkElement.Style="{StaticResource BadgeTextStyle}" />
                      </Border>
                      <Border FrameworkElement.Style="{StaticResource BadgeStyle}">
                        <UIElement.Visibility>
                          <Binding Converter="{StaticResource BoolToVisibility}">
                            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IsPatched</Ctor>
                          </Binding>
                        </UIElement.Visibility>
                        <TextBlock Text="Patched" FrameworkElement.Style="{StaticResource BadgeTextStyle}" />
                      </Border>
                    </WrapPanel>
                    <StackPanel Orientation="Horizontal" FrameworkElement.Margin="0,10,0,0">
                      <Button FrameworkElement.Style="{StaticResource SettingsTextButtonStyle}" ContentControl.Content="Execute" Control.Foreground="{DynamicResource AccentBrush}" FrameworkElement.ToolTip="Run on the attached clients">
                        <!--Unknown connection ID: 11-->
                      </Button>
                      <TextBlock Text="·" FrameworkElement.Margin="7,0" Foreground="{StaticResource TabForegroundBrush}" FrameworkElement.VerticalAlignment="Center" />
                      <Button FrameworkElement.Style="{StaticResource SettingsTextButtonStyle}" ContentControl.Content="Open" FrameworkElement.ToolTip="Open in a new editor tab">
                        <!--Unknown connection ID: 12-->
                      </Button>
                      <TextBlock Text="·" FrameworkElement.Margin="7,0" Foreground="{StaticResource TabForegroundBrush}" FrameworkElement.VerticalAlignment="Center" />
                      <Button FrameworkElement.Style="{StaticResource SettingsTextButtonStyle}" ContentControl.Content="Page" FrameworkElement.ToolTip="Open on rscripts.net">
                        <!--Unknown connection ID: 13-->
                      </Button>
                    </StackPanel>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <!--Unknown connection ID: 10-->
      </ScrollViewer>
    </Grid>
    <Grid Row="3" FrameworkElement.Margin="30,0,30,18">
      <UIElement.Visibility>
        <Binding Converter="{StaticResource BoolToVisibility}">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Hub.ShowResults</Ctor>
        </Binding>
      </UIElement.Visibility>
      <TextBlock FrameworkElement.VerticalAlignment="Center" FontFamily="{StaticResource BodyFont}" FontSize="10.5" Foreground="{StaticResource TabForegroundBrush}">
        <TextBlock.Text>
          <Binding>
            <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Hub.ResultsText</Ctor>
          </Binding>
        </TextBlock.Text>
      </TextBlock>
      <StackPanel Orientation="Horizontal" FrameworkElement.HorizontalAlignment="Right">
        <Button FrameworkElement.Style="{StaticResource SettingsTextButtonStyle}" ContentControl.Content="Previous">
          <UIElement.IsEnabled>
            <Binding>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Hub.CanGoBack</Ctor>
            </Binding>
          </UIElement.IsEnabled>
          <!--Unknown connection ID: 14-->
        </Button>
        <TextBlock FrameworkElement.Margin="14,0" FrameworkElement.VerticalAlignment="Center" FontFamily="{StaticResource BodyFont}" FontSize="10.5" Foreground="{StaticResource TabForegroundBrush}">
          <TextBlock.Text>
            <Binding>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Hub.PageText</Ctor>
            </Binding>
          </TextBlock.Text>
        </TextBlock>
        <Button FrameworkElement.Style="{StaticResource SettingsTextButtonStyle}" ContentControl.Content="Next">
          <UIElement.IsEnabled>
            <Binding>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Hub.CanGoForward</Ctor>
            </Binding>
          </UIElement.IsEnabled>
          <!--Unknown connection ID: 15-->
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</UserControl>