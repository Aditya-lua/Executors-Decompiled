  <Style x:Key="CaptionButtonStyle">
    <Style.TargetType>
      <x:TypeExtension>
        <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
      </x:TypeExtension>
    </Style.TargetType>
    <Setter xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework" Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True" />
    <Setter Property="FrameworkElement.Width" Value="21" />
    <Setter Property="FrameworkElement.Height" Value="36" />
    <Setter Property="Control.FontFamily">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">CaptionIconFont</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="Control.FontSize" Value="12" />
    <Setter Property="Control.Foreground">
      <Setter.Value>
        <StaticResourceExtension xmlns="">
          <Ctor xmlns="https://github.com/icsharpcode/ILSpy">TextMutedBrush</Ctor>
        </StaticResourceExtension>
      </Setter.Value>
    </Setter>
    <Setter Property="Control.Background" Value="#00FFFFFF" />
    <Setter Property="Control.BorderThickness" Value="0" />
    <Setter Property="UIElement.Focusable" Value="False" />
    <Setter Property="Control.Template">
      <Setter.Value>
        <ControlTemplate>
          <ControlTemplate.TargetType>
            <x:TypeExtension>
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">Button</Ctor>
            </x:TypeExtension>
          </ControlTemplate.TargetType>
          <Border Background="{TemplateBinding Control.Background}">
            <ContentPresenter FrameworkElement.HorizontalAlignment="Center" FrameworkElement.VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Triggers>
      <Trigger Property="UIElement.IsMouseOver" Value="True">
        <Setter Property="Control.Foreground">
          <Setter.Value>
            <StaticResourceExtension xmlns="">
              <Ctor xmlns="https://github.com/icsharpcode/ILSpy">IconFillBrush</Ctor>
            </StaticResourceExtension>
          </Setter.Value>
        </Setter>
      </Trigger>
      <Trigger Property="ButtonBase.IsPressed" Value="True">
        <Setter Property="UIElement.Opacity" Value="0.6" />
      </Trigger>
    </Style.Triggers>
  </Style>
