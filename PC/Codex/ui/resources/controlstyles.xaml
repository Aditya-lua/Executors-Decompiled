  <Style x:Key="{x:Type Controls:TabControl}" TargetType="{x:Type Controls:TabControl}">
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Controls:TabControl}">
          <Grid ClipToBounds="True" SnapsToDevicePixels="True">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Name="PART_HeaderHost" Row="0" ZIndex="2" Background="#00FFFFFF">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <ScrollViewer Name="PART_TabScroller" Grid.Column="0" Margin="0,0,0,-1" Panel.ZIndex="1" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled" Style="{StaticResource OverlayScrollViewer}" MaxWidth="{Binding ActualWidth, ElementName=PART_HeaderHost, ConverterParameter=40, Converter={StaticResource SubtractConverter}}">
                <StackPanel Name="PART_TabPanel" Margin="2,2,2,0" IsItemsHost="True" Orientation="Horizontal" />
              </ScrollViewer>
              <Controls:Button x:Name="PART_AddTab" Grid.Column="1" Width="22" Height="22" Margin="-4,2,6,0" VerticalAlignment="Top" AutomationProperties.Name="New Tab" Command="{x:Static Controls:TabControl.NewTabCommand}" CornerRadius="6" ToolTip="New Tab" UseLayoutRounding="True" Style="{StaticResource TabCloseButton}">
                <Path Width="10" Height="10" HorizontalAlignment="Center" VerticalAlignment="Center" Data="{DynamicResource Icon.Plus}" SnapsToDevicePixels="True" Stretch="Uniform" Stroke="#C9CCD6" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeThickness="1.5" />
              </Controls:Button>
              <Border Name="PART_DropIndicator" Grid.ColumnSpan="2" Width="2" Height="20" Margin="0,5,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" Panel.ZIndex="10" Background="{DynamicResource Page.Accent}" CornerRadius="1" IsHitTestVisible="False" Visibility="Collapsed" />
            </Grid>
            <Grid Row="1">
              <Border Name="ContentFrame" BorderBrush="#1E2029" BorderThickness="1" CornerRadius="0,5,5,5">
                <Border.Background>
                  <ImageBrush ImageSource="/Assets/Images/Secondary-1.png" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" />
                </Border.Background>
              </Border>
              <Grid>
                <ContentPresenter Name="EditorHost" Margin="1" Content="{TemplateBinding Controls:TabControl.Content}" SnapsToDevicePixels="True" />
                <Grid Name="EmptyHost" IsEnabled="False" IsHitTestVisible="False" Opacity="0">
                  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Controls:EmptyState Title="No Open Tabs" HorizontalAlignment="Center" Message="Create a new tab to start editing." Icon="{StaticResource Icon.File}" />
                    <Controls:Button Margin="0,14,0,0" HorizontalAlignment="Center" AutomationProperties.Name="New Tab" Command="{x:Static Controls:TabControl.NewTabCommand}" Style="{StaticResource ActionBarAccent}">
                      <StackPanel Orientation="Horizontal">
                        <Path Width="10" Height="10" Margin="0,0,6,0" Data="{DynamicResource Icon.Plus}" Stretch="Uniform" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeThickness="1.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Controls:Button}}}" />
                        <TextBlock VerticalAlignment="Center" Text="New Tab" />
                      </StackPanel>
                    </Controls:Button>
                  </StackPanel>
                </Grid>
              </Grid>
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="Controls:TabControl.HasTabs" Value="False">
              <Setter TargetName="ContentFrame" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="PART_HeaderHost" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="EditorHost" Property="Visibility" Value="Hidden" />
              <Setter TargetName="EmptyHost" Property="IsEnabled" Value="True" />
              <Setter TargetName="EmptyHost" Property="UIElement.IsHitTestVisible" Value="True" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="EmptyHost" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.15" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="EmptyHost" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.1" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>