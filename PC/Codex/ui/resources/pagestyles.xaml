  <Style x:Key="Menu.Dark" TargetType="{x:Type ContextMenu}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="ContextMenu.HasDropShadow" Value="False" />
    <Setter Property="Foreground" Value="{StaticResource Page.Foreground}" />
    <Setter Property="FontFamily" Value="{StaticResource Inter}" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ContextMenu}">
          <Border Margin="8">
            <Border Padding="4" Background="#16171D" BorderThickness="1" CornerRadius="7" BorderBrush="{StaticResource Page.ControlBorder}">
              <UIElement.Effect>
                <DropShadowEffect BlurRadius="14" Opacity="0.55" ShadowDepth="0" Color="Black" />
              </UIElement.Effect>
              <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
            </Border>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
    <Style.Resources>
      <ResourceDictionary>
        <Style x:Key="{x:Type MenuItem}" TargetType="{x:Type MenuItem}">
          <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
          <Setter Property="Foreground" Value="{StaticResource Page.Foreground}" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type MenuItem}">
                <Border Name="Row" MinWidth="130" Padding="10,5" Background="#00FFFFFF" CornerRadius="5" SnapsToDevicePixels="True">
                  <ContentPresenter ContentSource="Header" RecognizesAccessKey="False" TextElement.Foreground="{TemplateBinding Control.Foreground}" />
                </Border>
                <ControlTemplate.Triggers>
                  <Trigger Property="MenuItem.IsHighlighted" Value="True">
                    <Setter TargetName="Row" Property="Border.Background" Value="#282B35" />
                  </Trigger>
                  <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="UIElement.Opacity" Value="0.4" />
                  </Trigger>
                  <Trigger Property="FrameworkElement.Tag" Value="danger">
                    <Setter Property="Foreground" Value="{StaticResource Toast.Error}" />
                  </Trigger>
                </ControlTemplate.Triggers>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
        <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
          <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="{x:Type Separator}">
                <Border Height="1" Margin="6,3" Background="{StaticResource Page.ControlBorder}" />
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Style>
      </ResourceDictionary>
    </Style.Resources>
  </Style>
  <Style x:Key="{x:Type ToolTip}" TargetType="{x:Type ToolTip}">
    <Setter Property="FrameworkElement.OverridesDefaultStyle" Value="True" />
    <Setter Property="ToolTip.HasDropShadow" Value="False" />
    <Setter Property="ToolTip.Placement" Value="Bottom" />
    <Setter Property="ToolTip.VerticalOffset" Value="-2" />
    <Setter Property="Background" Value="#00FFFFFF" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Foreground" Value="{StaticResource Page.Foreground}" />
    <Setter Property="FontFamily" Value="{StaticResource Inter}" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToolTip}">
          <Border Name="Root" Margin="8">
            <UIElement.RenderTransform>
              <TranslateTransform />
            </UIElement.RenderTransform>
            <Border Padding="10,6" Background="#16171D" BorderThickness="1" CornerRadius="7" BorderBrush="{StaticResource Page.ControlBorder}">
              <UIElement.Effect>
                <DropShadowEffect BlurRadius="14" Opacity="0.55" ShadowDepth="0" Color="Black" />
              </UIElement.Effect>
              <ContentPresenter TextElement.Foreground="{TemplateBinding Control.Foreground}">
                <FrameworkElement.Resources>
                  <ResourceDictionary>
                    <Style x:Key="{x:Type TextBlock}" TargetType="{x:Type TextBlock}">
                      <Setter Property="MaxWidth" Value="260" />
                      <Setter Property="TextWrapping" Value="Wrap" />
                    </Style>
                  </ResourceDictionary>
                </FrameworkElement.Resources>
              </ContentPresenter>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ToolTip.IsOpen" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard Name="TipIn">
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="{x:Static app:MotionDurations.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="4" To="0" Duration="{x:Static app:MotionDurations.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <RemoveStoryboard BeginStoryboardName="TipIn" />
              </TriggerBase.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
