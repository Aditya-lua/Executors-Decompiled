  <Style x:Key="EmailBox" TargetType="{x:Type TextBox}">
    <Setter Property="Height" Value="34" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{StaticResource Page.Foreground}" />
    <Setter Property="TextBoxBase.CaretBrush" Value="{StaticResource Page.Foreground}" />
    <Setter Property="TextBoxBase.SelectionBrush" Value="{DynamicResource Page.Accent}" />
    <Setter Property="Background" Value="{StaticResource Page.Control}" />
    <Setter Property="BorderBrush" Value="{StaticResource Page.ControlBorder}" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Name="Chrome" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Path Width="12" Height="12" Margin="12,0,8,0" Stretch="Uniform" Stroke="{DynamicResource Page.Accent}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.3" Data="{StaticResource Icon.Mail}" />
              <TextBlock Name="Placeholder" Grid.Column="1" Margin="2,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Foreground="{StaticResource Page.Dim}" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              <ScrollViewer Name="PART_ContentHost" Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Value="{DynamicResource Page.AccentBorder}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="UIElement.Opacity" Value="0.5" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="LinkButton" TargetType="{x:Type Button}">
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource Page.Muted}" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Root" Padding="4,3" Background="#00FFFFFF" CornerRadius="4">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Value="{DynamicResource Page.Accent}" Property="Foreground" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="Border.Background" Value="{StaticResource Page.Control}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.45" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ToastLink" TargetType="{x:Type ToggleButton}">
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{StaticResource Page.Muted}" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ToggleButton}">
          <Border Name="Root" Padding="3,2" HorizontalAlignment="Left" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="1" CornerRadius="4">
            <StackPanel Orientation="Horizontal">
              <TextBlock Name="Label" VerticalAlignment="Center" FontSize="{TemplateBinding Control.FontSize}" Foreground="{TemplateBinding Control.Foreground}" Text="View Details" />
              <Path Name="Chevron" Width="5" Height="8" Margin="5,1,0,0" RenderTransformOrigin="0.5,0.5" Stretch="Uniform" Stroke="{TemplateBinding Control.Foreground}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.2" Data="{StaticResource Icon.Chevron}">
                <UIElement.RenderTransform>
                  <RotateTransform Angle="90" />
                </UIElement.RenderTransform>
              </Path>
            </StackPanel>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Label" Property="TextBlock.Text" Value="Hide details" />
              <Setter TargetName="Chevron" Property="RenderTransform">
                <Setter.Value>
                  <RotateTransform Angle="-90" />
                </Setter.Value>
              </Setter>
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Page.Foreground}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ClientCheckBox" TargetType="{x:Type CheckBox}">
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Border Background="#00FFFFFF">
            <Border Name="Box" Width="16" Height="16" BorderThickness="1" CornerRadius="5" Background="{StaticResource Page.Control}" BorderBrush="{StaticResource Page.ControlBorder}">
              <Path Name="Check" Width="8" Height="7" Opacity="0" Stretch="Uniform" Stroke="{DynamicResource Page.Accent}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.6" Data="{StaticResource Icon.Check}" />
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Box" Value="{DynamicResource Page.AccentBorder}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter TargetName="Box" Value="{DynamicResource Page.AccentSurface}" Property="Border.Background" />
              <Setter TargetName="Box" Value="{DynamicResource Page.Accent}" Property="Border.BorderBrush" />
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.12" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ClientCard" TargetType="{x:Type Border}">
    <Setter Property="Height" Value="68" />
    <Setter Property="Margin" Value="0,0,0,8" />
    <Setter Property="Background" Value="{StaticResource Page.CardSurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Page.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Border.CornerRadius" Value="10" />
  </Style>
  <Style x:Key="{x:Type Controls:EmptyState}" TargetType="{x:Type Controls:EmptyState}">
    <Setter Property="UIElement.IsHitTestVisible" Value="False" />
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Controls:EmptyState}">
          <StackPanel>
            <Path Width="32" Height="32" Margin="0,0,0,12" HorizontalAlignment="Center" Data="{TemplateBinding Controls:EmptyState.Icon}" Stretch="Uniform" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.2" Stroke="{StaticResource Page.Dim}" />
            <TextBlock HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold" Text="{TemplateBinding Controls:EmptyState.Title}" Foreground="{StaticResource Page.Foreground}" />
            <TextBlock Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="9" Text="{TemplateBinding Controls:EmptyState.Message}" Foreground="{StaticResource Page.Muted}" />
          </StackPanel>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Text.PageHeader" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Page.Foreground}" />
  </Style>
  <Style x:Key="Text.PageSubtitle" TargetType="{x:Type TextBlock}">
    <Setter Property="Margin" Value="0,4,0,0" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Page.Muted}" />
  </Style>
  <Style x:Key="Text.SectionTitle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Page.Foreground}" />
  </Style>
  <Style x:Key="Text.CardTitle" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Page.Foreground}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="Text.Body" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="8.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Page.Muted}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="DashboardCard" TargetType="{x:Type Border}">
    <Setter Property="Background" Value="{StaticResource Page.CardSurface}" />
    <Setter Property="BorderBrush" Value="{StaticResource Page.Border}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Border.CornerRadius" Value="8" />
    <Setter Property="Border.Padding" Value="10" />
    <Setter Property="UIElement.Effect">
      <Setter.Value>
        <DropShadowEffect BlurRadius="12" Opacity="0.35" ShadowDepth="0" Color="Black" />
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="Divider" TargetType="{x:Type Border}">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{StaticResource Page.Border}" />
  </Style>
  <Style x:Key="SearchBox" TargetType="{x:Type TextBox}">
    <Setter Property="Height" Value="28" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="Foreground" Value="{StaticResource Page.Foreground}" />
    <Setter Property="TextBoxBase.CaretBrush" Value="{StaticResource Page.Foreground}" />
    <Setter Property="TextBoxBase.SelectionBrush" Value="{DynamicResource Page.Accent}" />
    <Setter Property="Background" Value="{StaticResource Page.Control}" />
    <Setter Property="BorderBrush" Value="{StaticResource Page.ControlBorder}" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type TextBox}">
          <Border Name="Chrome" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" CornerRadius="14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Path Width="10" Height="10" Margin="12,0,7,0" Stretch="Uniform" Stroke="{DynamicResource Page.Accent}" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeThickness="1.4" Data="{StaticResource Icon.Search}" />
              <TextBlock Name="Placeholder" Grid.Column="1" Margin="2,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False" Visibility="Collapsed" Foreground="{StaticResource Page.Dim}" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
              <ScrollViewer Name="PART_ContentHost" Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center" Focusable="False" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Text" Value="">
              <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="Chrome" Value="{DynamicResource Page.AccentBorder}" Property="Border.BorderBrush" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="FilterPill" TargetType="{x:Type RadioButton}">
    <Setter Property="Height" Value="26" />
    <Setter Property="Margin" Value="0,0,8,0" />
    <Setter Property="FontSize" Value="8.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{StaticResource Page.Muted}" />
    <Setter Property="Background" Value="{StaticResource Page.Control}" />
    <Setter Property="BorderBrush" Value="{StaticResource Page.ControlBorder}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid>
            <Border Name="Chrome" Padding="11,0,12,0" Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="1" CornerRadius="13" RenderTransformOrigin="0.5,0.5">
              <UIElement.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
              </UIElement.RenderTransform>
              <Grid>
                <Border Name="Hover" Margin="-11,0,-12,0" Background="#FFFFFFFF" CornerRadius="13" IsHitTestVisible="False" Opacity="0" />
                <Border Name="CheckedOn" Margin="-12,-1,-13,-1" Background="{DynamicResource Page.AccentSurface}" BorderBrush="{DynamicResource Page.AccentBorder}" BorderThickness="1" CornerRadius="13" IsHitTestVisible="False" Opacity="0" />
                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                  <Grid Name="IconHost" Margin="0,0,6,0">
                    <Path Name="Icon" Width="9" Height="9" Stretch="Uniform" Fill="{StaticResource Page.Dim}" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                    <Path Name="IconOn" Width="9" Height="9" Fill="{DynamicResource Page.Accent}" Opacity="0" Stretch="Uniform" Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                  </Grid>
                  <ContentPresenter VerticalAlignment="Center" />
                </StackPanel>
              </Grid>
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="FrameworkElement.Tag" Value="{x:Null}">
              <Setter TargetName="IconHost" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Page.Foreground}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Page.Foreground}" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CheckedOn" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Normal}">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="IconOn" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Normal}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="CheckedOn" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="IconOn" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.06" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.96" Duration="{StaticResource Motion.Press}" />
                    <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.96" Duration="{StaticResource Motion.Press}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Fast}">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Chrome" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource Motion.Fast}">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Chrome" Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="AccentSwatch" TargetType="{x:Type RadioButton}">
    <Setter Property="Width" Value="18" />
    <Setter Property="Height" Value="18" />
    <Setter Property="Margin" Value="6,0,0,0" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type RadioButton}">
          <Grid Name="Root" Background="#00FFFFFF" RenderTransformOrigin="0.5,0.5">
            <UIElement.RenderTransform>
              <ScaleTransform ScaleX="1" ScaleY="1" />
            </UIElement.RenderTransform>
            <Ellipse Name="Ring" Opacity="0" RenderTransformOrigin="0.5,0.5" Stroke="{TemplateBinding Control.Background}" StrokeThickness="1">
              <UIElement.RenderTransform>
                <ScaleTransform ScaleX="0.7" ScaleY="0.7" />
              </UIElement.RenderTransform>
            </Ellipse>
            <Ellipse Name="Dot" Width="12" Height="12" Fill="{TemplateBinding Control.Background}" RenderTransformOrigin="0.5,0.5">
              <UIElement.RenderTransform>
                <ScaleTransform ScaleX="1" ScaleY="1" />
              </UIElement.RenderTransform>
            </Ellipse>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Normal}" />
                    <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Normal}">
                      <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.35" EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource Motion.Normal}">
                      <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.35" EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.7" Duration="{StaticResource Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="Ring" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.7" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.12" Duration="{StaticResource Motion.Fast}">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.12" Duration="{StaticResource Motion.Fast}">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="Dot" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="0.9" Duration="{StaticResource Motion.Press}" />
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="0.9" Duration="{StaticResource Motion.Press}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Fast}">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="{StaticResource Motion.Fast}">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="CardCheckBox" TargetType="{x:Type CheckBox}">
    <Setter Property="FontSize" Value="8.5" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Page.Muted}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <StackPanel Background="#00FFFFFF" Orientation="Horizontal">
            <Border Name="Box" Width="12" Height="12" BorderThickness="1" CornerRadius="3.5" Background="{StaticResource Page.Control}" BorderBrush="{StaticResource Page.ControlBorder}">
              <Path Name="Check" Width="7" Height="6" Stretch="Uniform" Stroke="{DynamicResource Page.Accent}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.5" Visibility="Hidden" Data="{StaticResource Icon.Check}" />
            </Border>
            <ContentPresenter Margin="6,0,0,0" VerticalAlignment="Center" />
          </StackPanel>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Box" Value="{DynamicResource Page.AccentBorder}" Property="Border.BorderBrush" />
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <Setter Property="Foreground" Value="{StaticResource Page.Foreground}" />
              <Setter TargetName="Box" Value="{DynamicResource Page.AccentSurface}" Property="Border.Background" />
              <Setter TargetName="Box" Value="{DynamicResource Page.Accent}" Property="Border.BorderBrush" />
              <Setter TargetName="Check" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ToggleSwitch" TargetType="{x:Type CheckBox}">
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type CheckBox}">
          <Grid Name="Root" Width="26" Height="14" Background="#00FFFFFF" SnapsToDevicePixels="True">
            <Border Name="Track" BorderThickness="1" CornerRadius="7" Background="{StaticResource Page.Control}" BorderBrush="{StaticResource Page.ControlBorder}" />
            <Border Name="TrackOn" Background="{DynamicResource Page.AccentSurface}" BorderBrush="{DynamicResource Page.AccentBorder}" BorderThickness="1" CornerRadius="7" Opacity="0" />
            <Border Name="Hover" Background="#FFFFFFFF" CornerRadius="7" IsHitTestVisible="False" Opacity="0" />
            <Grid Name="KnobHost" Width="8" Height="8" Margin="3,0,0,0" HorizontalAlignment="Left" RenderTransformOrigin="0.5,0.5">
              <UIElement.RenderTransform>
                <TransformGroup>
                  <ScaleTransform ScaleX="1" ScaleY="1" />
                  <TranslateTransform X="0" />
                </TransformGroup>
              </UIElement.RenderTransform>
              <Ellipse Fill="{StaticResource Page.Dim}" />
              <Ellipse Name="KnobOn" Fill="{DynamicResource Page.Accent}" Opacity="0" />
            </Grid>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="KnobHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" To="12" Duration="{StaticResource Motion.Normal}">
                      <DoubleAnimation.EasingFunction>
                        <BackEase Amplitude="0.35" EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="KnobOn" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                    <DoubleAnimation Storyboard.TargetName="KnobHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.X)" To="0" Duration="{StaticResource Motion.Normal}">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.25" Duration="{StaticResource Motion.Press}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="KnobHost" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="{StaticResource Motion.Fast}">
                      <DoubleAnimation.EasingFunction>
                        <CubicEase EasingMode="EaseOut" />
                      </DoubleAnimation.EasingFunction>
                    </DoubleAnimation>
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0.07" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Hover" Storyboard.TargetProperty="Opacity" To="0" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <TriggerBase.EnterActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="0.5" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.EnterActions>
              <TriggerBase.ExitActions>
                <BeginStoryboard>
                  <Storyboard>
                    <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" To="1" Duration="{StaticResource Motion.Fast}" />
                  </Storyboard>
                </BeginStoryboard>
              </TriggerBase.ExitActions>
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="SettingRow" TargetType="{x:Type HeaderedContentControl}">
    <Setter Property="Margin" Value="0,12,0,0" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type HeaderedContentControl}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Margin="0,0,12,0">
              <TextBlock FontSize="9.5" FontWeight="SemiBold" Foreground="{StaticResource Page.Foreground}" Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
              <TextBlock Margin="0,3,0,0" Style="{StaticResource Text.Body}" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
            </StackPanel>
            <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
