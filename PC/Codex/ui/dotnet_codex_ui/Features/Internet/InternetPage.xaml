<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="dotnet_codex_ui.Features.Internet.InternetPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="clr-namespace:dotnet_codex_ui.Controls" xmlns:Internet="clr-namespace:dotnet_codex_ui.Features.Internet" TextElement.FontFamily="{StaticResource Inter}">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
      <ItemsPanelTemplate x:Key="CardsPanel">
        <UniformGrid Columns="4" />
      </ItemsPanelTemplate>
      <DataTemplate x:Key="SkeletonCard">
        <Border Margin="5,0,5,10" VerticalAlignment="Top" Style="{StaticResource DashboardCard}">
          <StackPanel>
            <Border Height="76" CornerRadius="6" Internet:Thumbnail.Shimmer="True" Background="{StaticResource Page.ThumbnailSurface}" />
            <Border Width="90" Height="11" Margin="0,12,0,0" HorizontalAlignment="Left" CornerRadius="4" Internet:Thumbnail.Shimmer="True" Background="{StaticResource Page.ThumbnailSurface}" />
            <Border Width="70" Height="8" Margin="0,10,0,0" HorizontalAlignment="Left" CornerRadius="4" Internet:Thumbnail.Shimmer="True" Background="{StaticResource Page.ThumbnailSurface}" />
            <Border Width="60" Height="8" Margin="0,8,0,0" HorizontalAlignment="Left" CornerRadius="4" Internet:Thumbnail.Shimmer="True" Background="{StaticResource Page.ThumbnailSurface}" />
            <Border Margin="0,26,0,8" Style="{StaticResource Divider}" />
            <Border Width="110" Height="9" HorizontalAlignment="Left" CornerRadius="4" Internet:Thumbnail.Shimmer="True" Background="{StaticResource Page.ThumbnailSurface}" />
          </StackPanel>
        </Border>
      </DataTemplate>
      <Style x:Key="ProviderCard" TargetType="{x:Type RadioButton}">
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="FrameworkElement.Cursor" Value="Hand" />
        <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
          <Setter.Value>
            <ControlTemplate TargetType="{x:Type RadioButton}">
              <Grid>
                <Border Name="Chrome" Padding="12,10" BorderThickness="1" CornerRadius="8" Background="{StaticResource Page.Control}" BorderBrush="{StaticResource Page.ControlBorder}">
                  <Grid>
                    <Border Name="Hover" Margin="-12,-10" Background="#FFFFFFFF" CornerRadius="8" IsHitTestVisible="False" Opacity="0" />
                    <Border Name="Selected" Margin="-13,-11" Background="{DynamicResource Page.AccentSurface}" BorderBrush="{DynamicResource Page.AccentBorder}" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False" Opacity="0" />
                    <StackPanel Orientation="Horizontal">
                      <Border Width="28" Height="28" Background="{DynamicResource Page.AccentSurface}" CornerRadius="7">
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Page.Accent}" Text="{Binding Content.DisplayName[0], Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
                      </Border>
                      <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                          <TextBlock VerticalAlignment="Center" FontSize="10.5" FontWeight="Bold" TextTrimming="CharacterEllipsis" Foreground="{StaticResource Page.Foreground}" Text="{Binding Content.DisplayName, RelativeSource={RelativeSource TemplatedParent}}" />
                          <Border Name="FeaturedPill" Margin="6,0,0,0" Padding="4,1.5" VerticalAlignment="Center" Background="{DynamicResource Page.AccentSurface}" CornerRadius="4" Visibility="Collapsed">
                            <TextBlock FontSize="6.5" FontWeight="Bold" Foreground="{DynamicResource Page.Accent}" Text="FEATURED" />
                          </Border>
                        </StackPanel>
                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Text.Body}" Text="{Binding Content.Tagline, RelativeSource={RelativeSource TemplatedParent}}" />
                      </StackPanel>
                    </StackPanel>
                  </Grid>
                </Border>
              </Grid>
              <ControlTemplate.Triggers>
                <Trigger Property="FrameworkElement.Tag" Value="featured">
                  <Setter TargetName="FeaturedPill" Property="Visibility" Value="Visible" />
                </Trigger>
                <Trigger Property="UIElement.IsMouseOver" Value="True">
                  <Setter TargetName="Hover" Property="UIElement.Opacity" Value="0.05" />
                </Trigger>
                <Trigger Property="ToggleButton.IsChecked" Value="True">
                  <Setter TargetName="Selected" Property="UIElement.Opacity" Value="1" />
                </Trigger>
                <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
                  <Setter TargetName="Chrome" Value="{DynamicResource Page.Accent}" Property="Border.BorderBrush" />
                </Trigger>
              </ControlTemplate.Triggers>
            </ControlTemplate>
          </Setter.Value>
        </Setter>
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid Margin="14,0,4,0">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="0,6,0,0">
      <StackPanel HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource Text.PageHeader}" Text="Scripts" />
        <TextBlock Style="{StaticResource Text.PageSubtitle}" Text="Pick a provider, then search its scripts." />
      </StackPanel>
      <TextBox Name="SearchBox" Width="210" HorizontalAlignment="Right" VerticalAlignment="Center" AutomationProperties.Name="Search scripts" Style="{StaticResource SearchBox}" Tag="Search..." TextChanged="SearchBox_TextChanged" />
    </Grid>
    <UniformGrid Name="ProviderPanel" Grid.Row="1" Margin="0,16,-8,0" Columns="3" />
    <Grid Row="2" Margin="0,16,0,0">
      <ScrollViewer Name="ResultsScroll" Margin="-10,-6,-10,0" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource OverlayScrollViewer}" Visibility="Collapsed" ScrollChanged="ResultsScroll_ScrollChanged">
        <StackPanel Margin="5,6,5,0">
          <ItemsControl Name="Cards" ItemsPanel="{StaticResource CardsPanel}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Name="Card" Margin="5,0,5,10" VerticalAlignment="Top" Cursor="Hand" Focusable="True" Style="{StaticResource DashboardCard}" AutomationProperties.Name="{Binding Title}" KeyDown="Card_KeyDown" MouseLeftButtonUp="Card_MouseLeftButtonUp">
                  <StackPanel>
                    <Border Height="76" Background="{StaticResource Page.ThumbnailSurface}" CornerRadius="6">
                      <Grid Internet:Thumbnail.Round="6">
                        <TextBlock Name="Letter" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="30" FontWeight="Bold" Foreground="{DynamicResource Page.Accent}" Opacity="0.5" Text="{Binding Initial}" />
                        <Border Name="Loading" Background="{StaticResource Page.ThumbnailSurface}" Internet:Thumbnail.Shimmer="True" />
                        <Image Name="Picture" RenderOptions.BitmapScalingMode="HighQuality" SnapsToDevicePixels="True" Stretch="UniformToFill" Internet:Thumbnail.Url="{Binding ThumbnailUrl}" />
                      </Grid>
                    </Border>
                    <TextBlock Margin="0,12,0,0" Style="{StaticResource Text.CardTitle}" TextTrimming="CharacterEllipsis" Text="{Binding Title}" ToolTip="{Binding Title}" />
                    <ItemsControl MinHeight="42" Margin="0,6,0,0" ItemsSource="{Binding Features}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate>
                          <Grid Margin="0,0,0,3">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="Auto" />
                              <ColumnDefinition Width="*" MinWidth="0" />
                            </Grid.ColumnDefinitions>
                            <Ellipse Width="3" Height="3" Margin="2,0,7,0" VerticalAlignment="Center" Fill="{StaticResource Page.Muted}" />
                            <TextBlock Grid.Column="1" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" Text="{Binding}" ToolTip="{Binding}" />
                          </Grid>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Grid Margin="0,8,0,0">
                      <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <Path Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center" Data="{StaticResource Icon.Spark}" Fill="{DynamicResource Page.Accent}" Stretch="Uniform" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="{Binding Access}" />
                      </StackPanel>
                      <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Path Width="9" Height="9" Margin="0,0,5,0" VerticalAlignment="Center" Data="{StaticResource Icon.Sync}" Stretch="Uniform" Stroke="{StaticResource Page.Muted}" StrokeThickness="1.3" />
                        <TextBlock VerticalAlignment="Center" Style="{StaticResource Text.Body}" Text="{Binding Status}" />
                      </StackPanel>
                    </Grid>
                    <Border Margin="0,10,0,8" Style="{StaticResource Divider}" />
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                      </Grid.ColumnDefinitions>
                      <Border Width="18" Height="18" Background="{DynamicResource Page.AccentSurface}" CornerRadius="9">
                        <Grid Internet:Thumbnail.Round="9">
                          <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="8" FontWeight="Bold" Foreground="{DynamicResource Page.Accent}" Text="{Binding AuthorInitial}" />
                          <Image RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" Internet:Thumbnail.Url="{Binding GameImageUrl}" />
                        </Grid>
                      </Border>
                      <TextBlock Grid.Column="1" Margin="6,0,0,0" VerticalAlignment="Center" Style="{StaticResource Text.Body}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Author}">
                        <Run Text="Script for" /> <Run FontWeight="Bold" Foreground="{StaticResource Page.Foreground}" Text="{Binding Author, Mode=OneWay}" /></TextBlock>
                    </Grid>
                  </StackPanel>
                </Border>
                <DataTemplate.Triggers>
                  <DataTrigger Value="True" Binding="{Binding IsHot}">
                    <Setter TargetName="Card" Property="Border.BorderBrush" Value="#7A74E8" />
                    <Setter TargetName="Card" Property="UIElement.Effect">
                      <Setter.Value>
                        <DropShadowEffect BlurRadius="16" Opacity="0.35" ShadowDepth="0" Color="#7A74E8" />
                      </Setter.Value>
                    </Setter>
                  </DataTrigger>
                  <DataTrigger Value="loaded" Binding="{Binding ElementName=Picture, Path=(Internet:Thumbnail.State)}">
                    <Setter TargetName="Loading" Property="UIElement.Visibility" Value="Collapsed" />
                    <Setter TargetName="Letter" Property="UIElement.Visibility" Value="Collapsed" />
                  </DataTrigger>
                  <DataTrigger Value="failed" Binding="{Binding ElementName=Picture, Path=(Internet:Thumbnail.State)}">
                    <Setter TargetName="Loading" Property="UIElement.Visibility" Value="Collapsed" />
                  </DataTrigger>
                </DataTemplate.Triggers>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
          <ItemsControl Name="Skeletons" ItemTemplate="{StaticResource SkeletonCard}" ItemsPanel="{StaticResource CardsPanel}" Visibility="Collapsed" />
          <StackPanel Name="FooterError" Margin="0,4,0,12" HorizontalAlignment="Center" Visibility="Collapsed">
            <TextBlock HorizontalAlignment="Center" Style="{StaticResource Text.Body}" Text="Couldn't load more scripts." TextWrapping="Wrap" />
            <Controls:Button Click="RetryMore_Click" Height="26" Margin="0,8,0,0" HorizontalAlignment="Center" AutomationProperties.Name="Retry loading more scripts" Content="Try Again" Style="{StaticResource ActionBarButton}" />
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <StackPanel Name="StatePanel" HorizontalAlignment="Center" VerticalAlignment="Center">
        <Controls:EmptyState x:Name="StateView" HorizontalAlignment="Center" Icon="{StaticResource Icon.Info}" />
        <Controls:Button x:Name="RetryButton" Click="Retry_Click" Height="26" Margin="0,12,0,0" HorizontalAlignment="Center" AutomationProperties.Name="Try again" Content="Try Again" Style="{StaticResource ActionBarButton}" Visibility="Collapsed" />
      </StackPanel>
    </Grid>
    <TextBlock Name="Attribution" Grid.Row="3" Margin="0,6,10,6" HorizontalAlignment="Right" FontSize="9" Opacity="0.6" Style="{StaticResource Text.Body}" Text="Powered by ScriptBlox.com" />
    <Internet:ScriptDetailOverlay x:Name="Detail" Grid.RowSpan="4" Margin="-14,0,-4,0" Panel.ZIndex="10" />
  </Grid>
</UserControl>