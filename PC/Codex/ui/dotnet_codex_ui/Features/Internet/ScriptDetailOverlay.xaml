<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="dotnet_codex_ui.Features.Internet.ScriptDetailOverlay" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="clr-namespace:dotnet_codex_ui.Controls" xmlns:Internet="clr-namespace:dotnet_codex_ui.Features.Internet" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" TextElement.FontFamily="{StaticResource Inter}" Visibility="Collapsed">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="DetailPill" TargetType="{x:Type Border}">
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Border.Padding" Value="6,2.5,8,2.5" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Border.CornerRadius" Value="3.5" />
        <Setter Property="Visibility" Value="Collapsed" />
      </Style>
      <Style x:Key="DetailLabel" TargetType="{x:Type Controls:SpacedTextBlock}">
        <Setter Property="Controls:SpacedTextBlock.CharacterSpacing" Value="7" />
        <Setter Property="Controls:SpacedTextBlock.FontFamily" Value="{StaticResource Inter}" />
        <Setter Property="Controls:SpacedTextBlock.FontSize" Value="8" />
        <Setter Property="Controls:SpacedTextBlock.FontWeight" Value="SemiBold" />
        <Setter Property="Controls:SpacedTextBlock.Foreground" Value="{StaticResource Page.Dim}" />
        <Setter Property="Margin" Value="0,14,0,6" />
      </Style>
      <Style x:Key="DetailBody" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{StaticResource Page.Muted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Border Name="Scrim" Background="#CC090A0F" CornerRadius="8" MouseLeftButtonDown="Scrim_MouseLeftButtonDown">
    <Border Name="Card" MaxWidth="520" Margin="24" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#13141A" BorderBrush="{StaticResource Page.ControlBorder}" BorderThickness="1" CornerRadius="10">
      <UIElement.Effect>
        <DropShadowEffect BlurRadius="24" Opacity="0.6" ShadowDepth="0" Color="Black" />
      </UIElement.Effect>
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" MinWidth="0" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Border Width="76" Height="76" VerticalAlignment="Top" Background="{StaticResource Page.ThumbnailSurface}" BorderBrush="{StaticResource Page.ControlBorder}" BorderThickness="1" CornerRadius="10">
            <Grid Internet:Thumbnail.Round="9">
              <TextBlock Name="Letter" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="26" FontWeight="Bold" Foreground="{DynamicResource Page.Accent}" Opacity="0.55" />
              <Border Name="Loading" Internet:Thumbnail.Shimmer="True">
                <FrameworkElement.Style>
                  <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="{StaticResource Page.ThumbnailSurface}" />
                    <Style.Triggers>
                      <DataTrigger Value="loaded" Binding="{Binding ElementName=Picture, Path=(Internet:Thumbnail.State)}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                      <DataTrigger Value="failed" Binding="{Binding ElementName=Picture, Path=(Internet:Thumbnail.State)}">
                        <Setter Property="Visibility" Value="Collapsed" />
                      </DataTrigger>
                    </Style.Triggers>
                  </Style>
                </FrameworkElement.Style>
              </Border>
              <Image Name="Picture" RenderOptions.BitmapScalingMode="HighQuality" Stretch="UniformToFill" />
            </Grid>
          </Border>
          <StackPanel Grid.Column="1" Margin="14,0,10,0" VerticalAlignment="Top">
            <TextBlock Name="TitleText" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Page.Foreground}" TextWrapping="Wrap" />
            <TextBlock Name="SubtitleText" Margin="0,4,0,0" FontSize="10" Foreground="{StaticResource Page.Muted}" TextTrimming="CharacterEllipsis" />
            <WrapPanel Margin="0,10,0,0">
              <Border Name="VerifiedPill" Background="#1F5FBF8A" BorderBrush="#4D5FBF8A" Style="{StaticResource DetailPill}">
                <Controls:SpacedTextBlock CharacterSpacing="7" FontFamily="{StaticResource Inter}" FontSize="8" FontWeight="SemiBold" Foreground="#5FBF8A" Text="VERIFIED" />
              </Border>
              <Border Name="KeyPill" Background="#1FE5B14B" BorderBrush="#4DE5B14B" Style="{StaticResource DetailPill}">
                <Controls:SpacedTextBlock CharacterSpacing="7" FontFamily="{StaticResource Inter}" FontSize="8" FontWeight="SemiBold" Foreground="#E5B14B" Text="KEY SYSTEM" />
              </Border>
              <Border Name="UniversalPill" Background="{DynamicResource Page.AccentSurface}" BorderBrush="{DynamicResource Page.AccentBorder}" Style="{StaticResource DetailPill}">
                <Controls:SpacedTextBlock CharacterSpacing="7" FontFamily="{StaticResource Inter}" FontSize="8" FontWeight="SemiBold" Foreground="{DynamicResource Page.Accent}" Text="UNIVERSAL" />
              </Border>
              <Border Name="PatchedPill" Background="#1FD26064" BorderBrush="#4DD26064" Style="{StaticResource DetailPill}">
                <Controls:SpacedTextBlock CharacterSpacing="7" FontFamily="{StaticResource Inter}" FontSize="8" FontWeight="SemiBold" Foreground="#D26064" Text="PATCHED" />
              </Border>
            </WrapPanel>
          </StackPanel>
          <Controls:Button x:Name="CloseButton" Click="Close_Click" Grid.Column="2" Width="26" Height="26" VerticalAlignment="Top" AutomationProperties.Name="Close" CornerRadius="7" Style="{StaticResource AccentIconButton}" ToolTip="Close">
            <Path Width="10" Height="10" Data="{StaticResource Icon.Close}" Stretch="Uniform" StrokeEndLineCap="Round" StrokeStartLineCap="Round" StrokeThickness="1.4" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Controls:Button}}}" />
          </Controls:Button>
        </Grid>
        <Border Margin="0,16,0,0" Style="{StaticResource Divider}" />
        <ScrollViewer Name="BodyScroll" MaxHeight="320" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource OverlayScrollViewer}">
          <StackPanel Margin="0,0,6,0">
            <StackPanel Name="LoadingPanel" Margin="0,16,0,6">
              <Border Width="220" Height="10" HorizontalAlignment="Left" Internet:Thumbnail.Shimmer="True" Background="{StaticResource Page.ThumbnailSurface}" CornerRadius="4" />
              <Border Height="10" Margin="0,10,0,0" Internet:Thumbnail.Shimmer="True" Background="{StaticResource Page.ThumbnailSurface}" CornerRadius="4" />
              <Border Width="300" Height="10" Margin="0,10,0,0" HorizontalAlignment="Left" Internet:Thumbnail.Shimmer="True" Background="{StaticResource Page.ThumbnailSurface}" CornerRadius="4" />
            </StackPanel>
            <StackPanel Name="ErrorPanel" Margin="0,16,0,6" Visibility="Collapsed">
              <TextBlock Margin="0,0,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Page.Foreground}" Text="Couldn't load script details" />
              <TextBlock Name="ErrorText" Style="{StaticResource DetailBody}" />
              <Controls:Button x:Name="RetryButton" Click="Retry_Click" Height="26" Margin="0,12,0,0" HorizontalAlignment="Left" AutomationProperties.Name="Retry loading script details" Content="Try Again" Style="{StaticResource ActionBarButton}" />
            </StackPanel>
            <StackPanel Name="DetailPanel" Visibility="Collapsed">
              <StackPanel Name="AboutSection">
                <Controls:SpacedTextBlock Style="{StaticResource DetailLabel}" Text="ABOUT" />
                <TextBlock Name="FeaturesText" Style="{StaticResource DetailBody}" />
              </StackPanel>
              <StackPanel Name="TagsSection">
                <Controls:SpacedTextBlock Style="{StaticResource DetailLabel}" Text="TAGS" />
                <ItemsControl Name="TagsList">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <WrapPanel />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Margin="0,0,6,6" Padding="7,3" Background="{StaticResource Page.ThumbnailSurface}" BorderBrush="{StaticResource Page.ControlBorder}" BorderThickness="1" CornerRadius="4">
                        <TextBlock FontSize="9" Foreground="{StaticResource Page.Muted}" Text="{Binding}" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <Controls:SpacedTextBlock Style="{StaticResource DetailLabel}" Text="DETAILS" />
              <TextBlock Name="OwnerText" Margin="0,0,0,4" Style="{StaticResource DetailBody}" />
              <TextBlock Name="StatsText" Margin="0,0,0,4" Style="{StaticResource DetailBody}" />
              <TextBlock Name="CreatedText" Margin="0,0,0,4" Style="{StaticResource DetailBody}" />
              <TextBlock Name="KeyLinkText" Margin="0,0,0,4" Style="{StaticResource DetailBody}" />
              <TextBlock Name="DiscordText" Margin="0,0,0,4" Style="{StaticResource DetailBody}" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
        <UniformGrid Margin="0,16,0,0" Columns="2">
          <Controls:Button x:Name="ExecuteButton" Click="Execute_Click" Height="32" Margin="0,0,5,0" AutomationProperties.Name="Execute script" IsEnabled="False" Style="{StaticResource ActionBarAccent}">
            <StackPanel Orientation="Horizontal">
              <Path Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center" Data="{StaticResource Icon.Zap}" Stretch="Uniform" StrokeLineJoin="Round" StrokeThickness="1.3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Controls:Button}}}" />
              <TextBlock VerticalAlignment="Center" Text="Execute" />
            </StackPanel>
          </Controls:Button>
          <Controls:Button x:Name="OpenButton" Click="OpenTab_Click" Height="32" Margin="5,0,0,0" AutomationProperties.Name="Open as new tab" IsEnabled="False" Style="{StaticResource ActionBarButton}">
            <StackPanel Orientation="Horizontal">
              <Path Width="12" Height="12" Margin="0,0,7,0" VerticalAlignment="Center" Data="{StaticResource Icon.File}" Stretch="Uniform" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType={x:Type Controls:Button}}}" />
              <TextBlock VerticalAlignment="Center" Text="Open as New Tab" />
            </StackPanel>
          </Controls:Button>
        </UniformGrid>
      </StackPanel>
    </Border>
  </Border>
</UserControl>