<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="dotnet_codex_ui.Features.Settings.SettingsPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="clr-namespace:dotnet_codex_ui.Controls" xmlns:Settings="clr-namespace:dotnet_codex_ui.Controls.Settings" xmlns:app="clr-namespace:dotnet_codex_ui.Core.Versioning" TextElement.FontFamily="{StaticResource Inter}" xmlns:settings="clr-namespace:dotnet_codex_ui.Features.Settings">
  <FrameworkElement.Resources>
    <ResourceDictionary>
      <Style x:Key="ValueText" TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="9.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Page.Foreground}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextBlock.TextAlignment" Value="Right" />
      </Style>
    </ResourceDictionary>
  </FrameworkElement.Resources>
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>
    <Grid Row="0" Margin="0,6,0,20">
      <StackPanel HorizontalAlignment="Left">
        <TextBlock Style="{StaticResource Text.PageHeader}" Text="Settings" />
        <TextBlock Style="{StaticResource Text.PageSubtitle}" Text="Manage your application preferences." />
      </StackPanel>
    </Grid>
    <ScrollViewer Grid.Row="1" Margin="-10,-6,0,0" HorizontalScrollBarVisibility="Disabled" Style="{StaticResource OverlayScrollViewer}">
      <StackPanel MaxWidth="820" Margin="10,6,10,10" HorizontalAlignment="Stretch">
        <Settings:SettingsSection Description="How Codex looks." Header="Appearance" Icon="{StaticResource Icon.Spark}">
          <StackPanel>
            <Settings:SettingsRow Description="Interface theme. Light isn't available yet." Header="Theme">
              <StackPanel Orientation="Horizontal">
                <RadioButton Height="22" Content="Dark" GroupName="Theme" IsChecked="True" Style="{StaticResource FilterPill}" />
                <RadioButton Height="22" Margin="0" Content="Light" GroupName="Theme" IsEnabled="False" Style="{StaticResource FilterPill}" />
              </StackPanel>
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Highlight colour for active items, primary actions and selections. Saved automatically." Header="Accent Color">
              <StackPanel Orientation="Horizontal">
                <StackPanel Name="AccentPanel" Orientation="Horizontal" />
                <Button Margin="10,0,0,0" AutomationProperties.Name="Reset Accent Color" Content="Reset" Style="{StaticResource LinkButton}" ToolTip="Back to the default accent" Click="ResetAccent_Click" />
              </StackPanel>
            </Settings:SettingsRow>
          </StackPanel>
        </Settings:SettingsSection>
        <Settings:SettingsSection Description="Window and closing behaviour." Header="Application" Icon="{StaticResource Icon.Monitor}">
          <StackPanel>
            <Settings:SettingsRow Description="Ask before the application exits." Header="Confirm Before Closing">
              <CheckBox Name="ConfirmToggle" AutomationProperties.Name="Confirm Before Closing" Style="{StaticResource ToggleSwitch}" Checked="Confirm_Changed" Unchecked="Confirm_Changed" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Keep the Codex window above other windows." Header="Always on Top">
              <CheckBox Name="AlwaysOnTopToggle" AutomationProperties.Name="Always on Top" Style="{StaticResource ToggleSwitch}" Tag="AlwaysOnTop" Checked="Bool_Changed" Unchecked="Bool_Changed" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Display helpful labels when hovering over navigation items." Header="Show Navigation Tooltips">
              <CheckBox Name="NavTooltipsToggle" AutomationProperties.Name="Show Navigation Tooltips" Style="{StaticResource ToggleSwitch}" Tag="ShowNavigationTooltips" Checked="Bool_Changed" Unchecked="Bool_Changed" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Show toasts for injection and errors." Header="Notifications" Status="Preview — Not Connected">
              <CheckBox IsChecked="True" Style="{StaticResource ToggleSwitch}" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Enable experimental features when available." Header="Experimental Build">
              <CheckBox AutomationProperties.Name="Experimental Build" IsChecked="False" IsEnabled="False" Style="{StaticResource ToggleSwitch}" />
            </Settings:SettingsRow>
          </StackPanel>
        </Settings:SettingsSection>
        <Settings:SettingsSection Description="Code editor behaviour." Header="Editor" Icon="{StaticResource Icon.File}">
          <StackPanel>
            <Settings:SettingsRow Description="Size of the code in the editor." Header="Font Size">
              <Settings:SliderSetting x:Name="EditorFontSlider" AccessibleName="Editor font size" Maximum="24" Minimum="8" Step="1" Unit="px" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Show parameter and type hints inline." Header="Inlay Hints">
              <CheckBox Name="InlayHintsToggle" AutomationProperties.Name="Inlay Hints" Style="{StaticResource ToggleSwitch}" Tag="InlayHints" Checked="Bool_Changed" Unchecked="Bool_Changed" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Show a code overview on one side of the editor." Header="Minimap">
              <ComboBox Name="MinimapBox" AutomationProperties.Name="Minimap position" Style="{StaticResource SettingsDropdown}" SelectionChanged="Minimap_SelectionChanged">
                <ComboBoxItem Content="Off" />
                <ComboBoxItem Content="Left" />
                <ComboBoxItem Content="Right" />
              </ComboBox>
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Keep a backup copy of your tabs as you work." Header="Auto Save Tabs">
              <CheckBox Name="AutoSaveToggle" AutomationProperties.Name="Auto Save Tabs" Style="{StaticResource ToggleSwitch}" Tag="AutoSaveTabs" Checked="Bool_Changed" Unchecked="Bool_Changed" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Reopen your saved tabs when Codex starts." Header="Continue Where You Left Off">
              <CheckBox Name="ContinueToggle" AutomationProperties.Name="Continue Where You Left Off" Style="{StaticResource ToggleSwitch}" Tag="ContinueWhereYouLeftOff" Checked="Bool_Changed" Unchecked="Bool_Changed" />
            </Settings:SettingsRow>
          </StackPanel>
        </Settings:SettingsSection>
        <Settings:SettingsSection Description="Resource limits and tuning for the game client." Header="Performance" Icon="{StaticResource Icon.Zap}">
          <StackPanel>
            <Settings:SettingsRow Description="Cap the frame rate." Header="FPS Limit" Status="Saved · Used Once a Client Connector Exists">
              <Settings:SliderSetting x:Name="FpsSlider" AccessibleName="FPS Limit" Maximum="360" Minimum="10" OffText="Unlimited" Step="1" Unit="FPS" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Limit how much CPU the client may use. 100% means no limit." Header="CPU Limit" Status="Saved · Used Once a Client Connector Exists">
              <Settings:SliderSetting x:Name="CpuSlider" AccessibleName="CPU Limit" Maximum="100" Minimum="5" Step="1" Unit="%" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Limit how much memory the client may use. The maximum is your installed RAM." Header="Memory Limit" Status="Saved · Used Once a Client Connector Exists">
              <Settings:SliderSetting x:Name="MemorySlider" AccessibleName="Memory Limit" Minimum="512" OffText="No Limit" Step="64" Unit="MB" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Reduce overhead for higher frame rates." Header="FPS Boost" Status="Saved · Used Once a Client Connector Exists">
              <CheckBox Name="FpsBoostToggle" AutomationProperties.Name="FPS Boost" Style="{StaticResource ToggleSwitch}" Tag="FpsBoost" Checked="Bool_Changed" Unchecked="Bool_Changed" />
            </Settings:SettingsRow>
          </StackPanel>
        </Settings:SettingsSection>
        <Settings:SettingsSection Description="The local server that games connect to. Games need this port and the access key." Header="Connections" Icon="{StaticResource Icon.Monitor}">
          <StackPanel>
            <Settings:SettingsRow Description="Whether the server is running right now." Header="Status">
              <TextBlock Name="TetherStatusText" Style="{StaticResource ValueText}" Text="Starting…" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Accept connections from games." Header="Connection Server">
              <CheckBox Name="TetherEnabledToggle" AutomationProperties.Name="Connection Server" Style="{StaticResource ToggleSwitch}" Tag="TetherEnabled" Checked="Bool_Changed" Unchecked="Bool_Changed" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Write detailed connection steps to the log file (logs folder). Never includes keys or script contents." Header="Connection Diagnostics">
              <CheckBox Name="TetherDiagnosticsToggle" AutomationProperties.Name="Connection Diagnostics" Style="{StaticResource ToggleSwitch}" Tag="TetherDiagnostics" Checked="Bool_Changed" Unchecked="Bool_Changed" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="The port games connect to on this PC (1024 to 65535). Takes effect straight away." Header="Port">
              <TextBox Name="TetherPortBox" Width="70" AutomationProperties.Name="Connection port" Style="{StaticResource SettingsNumberBox}" Tag="Port" LostKeyboardFocus="TetherBox_LostKeyboardFocus" PreviewKeyDown="TetherBox_PreviewKeyDown" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="How long a game has to finish connecting before it is dropped (500 to 30000 ms). Takes effect straight away." Header="Handshake Timeout (ms)">
              <TextBox Name="TetherHandshakeBox" Width="70" AutomationProperties.Name="Handshake timeout in milliseconds" Style="{StaticResource SettingsNumberBox}" Tag="Handshake" LostKeyboardFocus="TetherBox_LostKeyboardFocus" PreviewKeyDown="TetherBox_PreviewKeyDown" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Secret that games must have to connect. Keep it private; regenerating disconnects every game." Header="Access Key">
              <StackPanel Orientation="Horizontal">
                <Controls:Button x:Name="TetherCopyKeyButton" Click="TetherCopyKey_Click" Margin="0,0,6,0" AutomationProperties.Name="Copy access key" Content="Copy" Style="{StaticResource ActionBarButton}" />
                <Controls:Button x:Name="TetherRegenerateKeyButton" Click="TetherRegenerateKey_Click" AutomationProperties.Name="Regenerate access key" Content="Regenerate" Style="{StaticResource ActionBarButton}" />
              </StackPanel>
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Reveal the access key. Never shown again once you leave this page." Header="Show Access Key">
              <StackPanel Orientation="Horizontal">
                <TextBox Name="TetherAccessKeyBox" Width="300" Margin="0,0,10,0" AutomationProperties.Name="Access key" IsReadOnly="True" MaxLength="0" Style="{StaticResource SettingsNumberBox}" TextAlignment="Left" Visibility="Collapsed" />
                <CheckBox Name="TetherShowAccessKeyToggle" AutomationProperties.Name="Show Access Key" Style="{StaticResource ToggleSwitch}" Checked="TetherShowKeys_Changed" Unchecked="TetherShowKeys_Changed" />
              </StackPanel>
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="How data between Codex and a game is protected." Header="Encryption">
              <ComboBox Name="TetherEncryptionBox" AutomationProperties.Name="Encryption" Style="{StaticResource SettingsDropdown}" SelectionChanged="TetherEncryption_SelectionChanged">
                <ComboBoxItem Content="Off" Tag="Off" />
                <ComboBoxItem Content="Shared key" Tag="Shared" />
                <ComboBoxItem Content="Per game" Tag="PerClient" />
              </ComboBox>
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Refuse games that do not use encryption." Header="Require Encryption">
              <CheckBox Name="TetherRequireEncryptionToggle" AutomationProperties.Name="Require Encryption" Style="{StaticResource ToggleSwitch}" Tag="TetherRequireEncryption" Checked="Bool_Changed" Unchecked="Bool_Changed" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Reveal the shared encryption key currently in use. It changes whenever the server restarts. Only exists with Shared key encryption." Header="Show Encryption Key">
              <StackPanel Orientation="Horizontal">
                <TextBox Name="TetherEncryptionKeyBox" Width="300" Margin="0,0,10,0" AutomationProperties.Name="Encryption key" IsReadOnly="True" MaxLength="0" Style="{StaticResource SettingsNumberBox}" TextAlignment="Left" Visibility="Collapsed" />
                <CheckBox Name="TetherShowEncryptionKeyToggle" AutomationProperties.Name="Show Encryption Key" Style="{StaticResource ToggleSwitch}" Checked="TetherShowKeys_Changed" Unchecked="TetherShowKeys_Changed" />
              </StackPanel>
            </Settings:SettingsRow>
          </StackPanel>
        </Settings:SettingsSection>
        <Settings:SettingsSection Description="How Codex connects to the game client." Header="Roblox and Networking" Icon="{StaticResource Icon.Gamepad}">
          <StackPanel>
            <Settings:SettingsRow Description="Inject automatically when a game is detected that has not been injected." Header="Auto Inject">
              <CheckBox Name="AutoInjectToggle" AutomationProperties.Name="Auto Inject" Style="{StaticResource ToggleSwitch}" Tag="AutoInject" Checked="Bool_Changed" Unchecked="Bool_Changed" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="How long to wait before auto injecting a detected game (1 to 300 seconds)." Header="Auto Inject Delay (s)">
              <TextBox Name="AutoInjectDelayBox" Width="70" AutomationProperties.Name="Auto inject delay in seconds" Style="{StaticResource SettingsNumberBox}" LostKeyboardFocus="AutoInjectDelayBox_LostKeyboardFocus" PreviewKeyDown="AutoInjectDelayBox_PreviewKeyDown" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Tick a client as soon as it is injected." Header="Select Injected Clients">
              <CheckBox Name="AutoSelectInjectedToggle" AutomationProperties.Name="Select Injected Clients" Style="{StaticResource ToggleSwitch}" Tag="AutoSelectInjected" Checked="Bool_Changed" Unchecked="Bool_Changed" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Use RakNet for the client connection." Header="RakNet" Status="Coming Soon">
              <CheckBox Name="RakNetToggle" AutomationProperties.Name="RakNet" IsEnabled="False" Style="{StaticResource ToggleSwitch}" Tag="RakNet" Checked="Bool_Changed" Unchecked="Bool_Changed" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Use prereplicated data for the client connection." Header="Prereplicated" Status="Coming Soon">
              <CheckBox Name="PrereplicatedToggle" AutomationProperties.Name="Prereplicated" IsEnabled="False" Style="{StaticResource ToggleSwitch}" Tag="Prereplicated" Checked="Bool_Changed" Unchecked="Bool_Changed" />
            </Settings:SettingsRow>
          </StackPanel>
        </Settings:SettingsSection>
        <Settings:SettingsSection x:Name="DevSection" Description="Development builds only." Header="Developer Options" Icon="{StaticResource Icon.Sync}" Visibility="Collapsed">
          <Border Name="DevCard" Margin="0,12,0,0" />
        </Settings:SettingsSection>
        <Settings:SettingsSection Description="Privacy and configuration options. These are not anti-tampering or account security." Header="Security and Privacy" Icon="{StaticResource Icon.Octagon}">
          <StackPanel>
            <Settings:SettingsRow Description="Give the Codex window a random title (taskbar and Alt+Tab) instead of its normal name." Header="Random Window Title">
              <CheckBox Name="RandomTitleToggle" AutomationProperties.Name="Random Window Title" Style="{StaticResource ToggleSwitch}" Checked="RandomTitle_Changed" Unchecked="RandomTitle_Changed" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Description="Restore this app's own interface settings to their defaults. Other components' settings and your sign-in are not touched." Header="Reset UI Settings">
              <Controls:Button Click="ResetSettings_Click" MinWidth="64" AutomationProperties.Name="Reset UI Settings" Content="Reset" Style="{StaticResource ActionBarAccent}" />
            </Settings:SettingsRow>
          </StackPanel>
        </Settings:SettingsSection>
        <Settings:SettingsSection Description="Component versions." Header="About and Versions" Icon="{StaticResource Icon.Info}">
          <StackPanel>
            <Settings:SettingsRow x:Name="VersionStatusRow" Header="Version Source" Visibility="Collapsed">
              <TextBlock Name="VersionStatusText" Style="{StaticResource ValueText}" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Header="Bootstrapper Version">
              <TextBlock Name="BootstrapperVersionText" Style="{StaticResource ValueText}" Text="Checking…" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Header="UI Version">
              <StackPanel Orientation="Horizontal">
                <Label Name="UiVersionIcon" Width="16" Height="16" Margin="0,0,6,0" Padding="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Background="#00FFFFFF" Focusable="False" ToolTipService.InitialShowDelay="150" ToolTipService.Placement="Left" ToolTipService.ShowDuration="20000" Visibility="Collapsed">
                  <Path Name="UiVersionIconPath" Width="10" Height="10" Stretch="Uniform" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.6" />
                </Label>
                <TextBlock Name="UiVersionText" VerticalAlignment="Center" Style="{StaticResource ValueText}" Text="{x:Static app:AppVersions.UI}" />
              </StackPanel>
            </Settings:SettingsRow>
            <Settings:SettingsRow Header="Roblox Version">
              <TextBlock Name="RobloxVersionText" Style="{StaticResource ValueText}" Text="Checking…" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Header="Module Version">
              <TextBlock Name="ModuleVersionText" Style="{StaticResource ValueText}" Text="Checking…" />
            </Settings:SettingsRow>
            <Settings:SettingsRow Header="Loader Version">
              <TextBlock Name="LoaderVersionText" Style="{StaticResource ValueText}" Text="Checking…" />
            </Settings:SettingsRow>
          </StackPanel>
        </Settings:SettingsSection>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>