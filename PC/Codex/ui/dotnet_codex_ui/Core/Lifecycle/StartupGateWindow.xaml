<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="dotnet_codex_ui.Core.Lifecycle.StartupGateWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="clr-namespace:dotnet_codex_ui.Controls" Title="Codex" Width="500" AllowsTransparency="True" Background="#00FFFFFF" ResizeMode="NoResize" ShowInTaskbar="True" SizeToContent="Height" TextElement.FontFamily="{StaticResource Inter}" WindowStartupLocation="CenterScreen" WindowStyle="None" xmlns:lifecycle="clr-namespace:dotnet_codex_ui.Core.Lifecycle" KeyDown="Window_KeyDown" MouseLeftButtonDown="Window_MouseLeftButtonDown">
  <Border Padding="22" Background="#13141A" BorderBrush="{StaticResource Page.ControlBorder}" BorderThickness="1" CornerRadius="12">
    <StackPanel>
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Path Width="26" Height="26" Margin="0,0,14,0" VerticalAlignment="Top" Data="{StaticResource Icon.Octagon}" Stretch="Uniform" Stroke="{StaticResource Toast.Error}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.4" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Name="TitleText" FontSize="14" FontWeight="Bold" Foreground="{StaticResource Page.Foreground}" TextWrapping="Wrap" />
          <TextBlock Margin="0,2,0,0" FontSize="10" Foreground="{StaticResource Page.Muted}" Text="Codex did not start." />
        </StackPanel>
      </Grid>
      <TextBlock Name="SummaryText" Margin="0,14,0,0" FontSize="11" Foreground="{StaticResource Page.Foreground}" TextWrapping="Wrap" />
      <TextBox Name="DetailsBox" MaxHeight="170" Margin="0,12,0,0" Padding="6,4" Background="#0E0F14" BorderBrush="{StaticResource Page.ControlBorder}" BorderThickness="1" FontFamily="Consolas" FontSize="10" Foreground="{StaticResource Page.Muted}" HorizontalScrollBarVisibility="Auto" IsReadOnly="True" VerticalScrollBarVisibility="Auto">
        <Control.Template>
          <ControlTemplate TargetType="{x:Type TextBox}">
            <Border Background="{TemplateBinding Control.Background}" BorderBrush="{TemplateBinding Control.BorderBrush}" BorderThickness="{TemplateBinding Control.BorderThickness}" CornerRadius="8" SnapsToDevicePixels="True">
              <ScrollViewer Name="PART_ContentHost" Margin="{TemplateBinding Control.Padding}" Focusable="False" />
            </Border>
          </ControlTemplate>
        </Control.Template>
      </TextBox>
      <StackPanel Margin="0,16,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
        <Controls:Button x:Name="CopyButton" Click="Copy_Click" Margin="0,0,6,0" AutomationProperties.Name="Copy details" Content="Copy Details" Style="{StaticResource ActionBarButton}" />
        <Controls:Button x:Name="LogButton" Click="Log_Click" Margin="0,0,6,0" AutomationProperties.Name="Open log folder" Content="Open Log" Style="{StaticResource ActionBarButton}" />
        <Controls:Button x:Name="RetryButton" Click="Retry_Click" Margin="0,0,6,0" AutomationProperties.Name="Retry" Content="Retry" Style="{StaticResource ActionBarAccent}" />
        <Controls:Button x:Name="ExitButton" Click="Exit_Click" AutomationProperties.Name="Exit" Content="Exit" Style="{StaticResource ActionBarDanger}" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>