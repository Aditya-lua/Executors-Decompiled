<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="dotnet_codex_ui.Controls.Settings.SliderSetting" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Width="290" TextElement.FontFamily="{StaticResource Inter}" xmlns:settings="clr-namespace:dotnet_codex_ui.Controls.Settings;assembly=dotnet-codex-ui">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*" />
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>
    <StackPanel Name="OffRow" Grid.ColumnSpan="2" Margin="0,0,0,8" HorizontalAlignment="Right" Orientation="Horizontal" Visibility="Collapsed">
      <TextBlock Name="OffLabel" VerticalAlignment="Center" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource Page.Muted}" />
      <CheckBox Name="OffToggle" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource ToggleSwitch}" Checked="OffToggle_Changed" Unchecked="OffToggle_Changed" />
    </StackPanel>
    <Slider Name="Track" Grid.Row="1" VerticalAlignment="Center" IsMoveToPointEnabled="True" IsSnapToTickEnabled="True" Style="{StaticResource SettingsSlider}" PreviewMouseLeftButtonDown="Track_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="Track_PreviewMouseLeftButtonUp" ValueChanged="Track_ValueChanged" />
    <StackPanel Grid.Row="1" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" Orientation="Horizontal">
      <TextBox Name="NumberBox" Width="54" Style="{StaticResource SettingsNumberBox}" LostKeyboardFocus="NumberBox_LostKeyboardFocus" PreviewKeyDown="NumberBox_PreviewKeyDown" />
      <TextBlock Name="UnitText" MinWidth="22" Margin="6,0,0,0" VerticalAlignment="Center" FontSize="8.5" FontWeight="SemiBold" Foreground="{StaticResource Page.Muted}" />
    </StackPanel>
    <Grid Row="2" Margin="0,3,0,0">
      <TextBlock Name="MinLabel" HorizontalAlignment="Left" FontSize="8" FontWeight="Medium" Foreground="{StaticResource Page.Dim}" />
      <TextBlock Name="MaxLabel" HorizontalAlignment="Right" FontSize="8" FontWeight="Medium" Foreground="{StaticResource Page.Dim}" />
    </Grid>
    <TextBlock Name="Hint" Grid.Row="3" Grid.ColumnSpan="2" Margin="0,5,0,0" HorizontalAlignment="Right" FontSize="8.5" Foreground="{StaticResource Toast.Error}" TextWrapping="Wrap" Visibility="Collapsed" />
  </Grid>
</UserControl>