<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="dotnet_codex_ui.Controls.ConfirmDialog" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:Controls="clr-namespace:dotnet_codex_ui.Controls" KeyboardNavigation.ControlTabNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" TextElement.FontFamily="{StaticResource Inter}" Visibility="Collapsed">
  <Border Name="Scrim" Background="#CC090A0F" CornerRadius="10">
    <Border Name="Card" MaxWidth="340" Margin="24" Padding="18" HorizontalAlignment="Center" VerticalAlignment="Center" Background="#13141A" BorderBrush="{StaticResource Page.ControlBorder}" BorderThickness="1" CornerRadius="10">
      <UIElement.Effect>
        <DropShadowEffect BlurRadius="24" Opacity="0.6" ShadowDepth="0" Color="Black" />
      </UIElement.Effect>
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
          </Grid.ColumnDefinitions>
          <Path Name="Icon" Width="18" Height="18" Margin="0,0,10,0" VerticalAlignment="Center" Stretch="Uniform" Stroke="{DynamicResource Page.Accent}" StrokeEndLineCap="Round" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeThickness="1.4" />
          <Controls:SpacedTextBlock x:Name="TitleText" Grid.Column="1" VerticalAlignment="Center" CharacterSpacing="2" FontFamily="{StaticResource Inter}" FontSize="12" FontWeight="Bold" Foreground="{StaticResource Page.Foreground}" TextWrapping="Wrap" />
        </Grid>
        <TextBlock Name="MessageText" Margin="0,12,0,0" FontSize="10" Foreground="{StaticResource Page.Muted}" TextWrapping="Wrap" />
        <StackPanel Margin="0,18,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
          <Controls:Button x:Name="CancelButton" Click="Cancel_Click" Margin="0,0,6,0" AutomationProperties.Name="Cancel" Content="Cancel" Style="{StaticResource ActionBarButton}" />
          <Controls:Button x:Name="DiscardButton" Click="Discard_Click" Margin="0,0,6,0" AutomationProperties.Name="Discard" Style="{StaticResource ActionBarDanger}" Visibility="Collapsed" />
          <Controls:Button x:Name="ConfirmButton" Click="Confirm_Click" AutomationProperties.Name="Continue" Style="{StaticResource ActionBarAccent}" />
        </StackPanel>
      </StackPanel>
    </Border>
  </Border>
</UserControl>