<?xml version="1.0" encoding="utf-8"?>
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style x:Key="Text.Title" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Page.Foreground}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="Text.Description" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Page.Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style x:Key="Text.Label" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="7.5" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{StaticResource Page.Dim}" />
  </Style>
  <Style x:Key="Text.Value" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Page.Foreground}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="Text.Hint" TargetType="{x:Type TextBlock}">
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="Medium" />
    <Setter Property="Foreground" Value="{StaticResource Page.Muted}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>
  <Style x:Key="BootstrapperProgress" TargetType="{x:Type ProgressBar}">
    <Setter Property="Height" Value="8" />
    <Setter Property="RangeBase.Minimum" Value="0" />
    <Setter Property="RangeBase.Maximum" Value="100" />
    <Setter Property="Foreground" Value="{DynamicResource Page.Accent}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type ProgressBar}">
          <Border Name="PART_Track" BorderThickness="1" ClipToBounds="True" CornerRadius="4" SnapsToDevicePixels="True" Background="{StaticResource Page.Control}" BorderBrush="{StaticResource Page.ControlBorder}">
            <Grid>
              <Border Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Control.Foreground}" CornerRadius="3" />
              <Border Name="Sweep" Width="90" HorizontalAlignment="Left" Background="{TemplateBinding Control.Foreground}" CornerRadius="3" Opacity="0.85" Visibility="Collapsed">
                <UIElement.RenderTransform>
                  <TranslateTransform x:Name="SweepShift" X="-90" />
                </UIElement.RenderTransform>
              </Border>
            </Grid>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="ProgressBar.IsIndeterminate" Value="True">
              <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
              <Setter TargetName="Sweep" Property="Visibility" Value="Visible" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="ChromeButton" TargetType="{x:Type Button}">
    <Setter Property="Width" Value="26" />
    <Setter Property="Height" Value="26" />
    <Setter Property="Foreground" Value="{StaticResource Page.Muted}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Root" Background="#00FFFFFF" BorderBrush="#00FFFFFF" BorderThickness="1" CornerRadius="7">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Border.Background" Value="{StaticResource Page.Control}" />
              <Setter Property="Foreground" Value="{StaticResource Page.Foreground}" />
            </Trigger>
            <Trigger Property="UIElement.IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Value="{DynamicResource Page.AccentBorder}" Property="Border.BorderBrush" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="DemoButton" TargetType="{x:Type Button}">
    <Setter Property="Height" Value="22" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="FontSize" Value="9" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Page.Accent}" />
    <Setter Property="FrameworkElement.Cursor" Value="Hand" />
    <Setter Property="FrameworkElement.FocusVisualStyle" Value="{x:Null}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="{x:Type Button}">
          <Border Name="Root" Padding="{TemplateBinding Control.Padding}" Background="{DynamicResource Page.AccentSurface}" BorderBrush="{DynamicResource Page.AccentBorder}" BorderThickness="1" CornerRadius="6">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="UIElement.IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.85" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="UIElement.Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
</ResourceDictionary>